<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:charts="using:PhantomMonitor.App.Controls"
        xmlns:vm="using:PhantomMonitor.App.ViewModels"
        xmlns:views="using:PhantomMonitor.App.Views"
        x:Class="PhantomMonitor.App.Views.OverlayEditorWindow"
        Title="Editor do overlay flutuante"
        Width="1120" Height="820" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}">
  <Window.Styles>
    <StyleInclude Source="avares://PhantomMonitor/Themes/DesktopStyles.axaml" />
  </Window.Styles>
  <Grid x:Name="EditorCanvasViewport" ColumnDefinitions="*,Auto" SizeChanged="OnEditorCanvasViewportSizeChanged">
    <Border Grid.Column="0" ZIndex="30" IsVisible="{Binding HasConfigurationWarning}"
            VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="12"
            Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource AccentWarningBrush}"
            BorderThickness="1" CornerRadius="6" Padding="10">
      <TextBlock Text="{Binding ConfigurationWarning}" Foreground="{DynamicResource AccentWarningBrush}" TextWrapping="Wrap" />
    </Border>
    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <Grid x:Name="EditorCanvasSurface" Width="{Binding OverlayEditorCanvasWidth}" Height="{Binding OverlayEditorCanvasHeight}"
            Background="{DynamicResource BgOverlayPanelBrush}" PointerPressed="OnCanvasPointerPressed">
        <charts:OverlayGridCanvas x:Name="EditorGrid" Width="{Binding OverlayEditorCanvasWidth}" Height="{Binding OverlayEditorCanvasHeight}"
                                  LineBrush="{DynamicResource OverlayGridBrush}" GridSpacing="20" />
        <ItemsControl x:Name="EditorBlockCanvas" ItemsSource="{Binding OverlayBlocks}"
                      Width="{Binding OverlayEditorCanvasWidth}" Height="{Binding OverlayEditorCanvasHeight}">
            <ItemsControl.ItemContainerTheme>
              <ControlTheme TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />
                <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />
              </ControlTheme>
            </ItemsControl.ItemContainerTheme>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Viewbox Width="{Binding PreviewBlockWidth}" Height="{Binding PreviewBlockHeight}"
                         IsVisible="{Binding IsEditorVisible}" Stretch="Fill"
                         Opacity="{Binding $parent[Window].DataContext.OverlayPreviewOpacity}"
                         PointerPressed="OnBlockPointerPressed" PointerMoved="OnBlockPointerMoved"
                         PointerReleased="OnBlockPointerReleased" PointerCaptureLost="OnBlockPointerCaptureLost"
                         DoubleTapped="OnBlockDoubleTapped" Cursor="SizeAll">
                  <Viewbox.ContextMenu>
                    <ContextMenu DataContext="{Binding}">
                      <MenuItem Header="Editar conteúdo" Click="OnEditBlockContentClick" />
                      <MenuItem Header="Remover bloco" Click="OnRemoveBlockClick" />
                    </ContextMenu>
                  </Viewbox.ContextMenu>
                  <views:OverlayBlockContentView SizeChanged="OnBlockPreviewSizeChanged" />
                </Viewbox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>

    <Grid x:Name="AppearanceSettingsHost" Grid.Column="1" Width="0" IsVisible="False" ClipToBounds="True">
      <Border x:Name="AppearanceSettingsPanel" Width="360" HorizontalAlignment="Left"
              Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgCardBorderBrush}"
              BorderThickness="1,0,0,0" Padding="16">
        <Border.RenderTransform>
          <TranslateTransform X="-360" />
        </Border.RenderTransform>
        <Grid RowDefinitions="Auto,*" RowSpacing="14">
          <StackPanel Spacing="4">
            <TextBlock Text="APARÊNCIA DO OVERLAY" Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Ajuste os valores e confira o resultado no canvas."
                       Classes="muted" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <views:OverlayAppearanceControls />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
            Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgCardBorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Fechar" Click="OnCloseClick" />
        <Button Classes="action accent" Content="Salvar e aplicar" Click="OnSaveSettingsClick" />
        <Button x:Name="AppearanceSettingsButton" Classes="action accent" Content="Configurações"
                Click="OnAppearanceSettingsClick" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
