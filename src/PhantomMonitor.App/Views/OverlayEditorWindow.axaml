<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:charts="using:PhantomMonitor.App.Controls"
        xmlns:vm="using:PhantomMonitor.App.ViewModels"
        x:Class="PhantomMonitor.App.Views.OverlayEditorWindow"
        Title="Editor do overlay flutuante"
        Width="1120" Height="820" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}">
  <Grid Margin="20" RowDefinitions="*,Auto" RowSpacing="12">
    <Grid>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="EditorCanvasSurface" Width="{Binding OverlayEditorCanvasWidth}" Height="{Binding OverlayEditorCanvasHeight}"
              Background="Transparent" PointerPressed="OnCanvasPointerPressed">
          <Border CornerRadius="6" Background="{DynamicResource BgOverlayPanelBrush}" BorderBrush="{DynamicResource OverlayBorderBrush}" BorderThickness="1" />
          <charts:OverlayGridCanvas Width="{Binding OverlayEditorCanvasWidth}" Height="{Binding OverlayEditorCanvasHeight}"
                                    LineBrush="{DynamicResource OverlayGridBrush}" GridSpacing="20" />
          <ItemsControl x:Name="EditorBlockCanvas" ItemsSource="{Binding OverlayBlocks}"
                        Width="{Binding OverlayEditorCanvasWidth}" Height="{Binding OverlayEditorCanvasHeight}">
            <ItemsControl.ItemContainerTheme>
              <ControlTheme TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />
                <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />
              </ControlTheme>
            </ItemsControl.ItemContainerTheme>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="{Binding $parent[Window].DataContext.OverlayPreviewWidth}"
                        IsVisible="{Binding IsEditorVisible}" CornerRadius="5"
                        Background="{DynamicResource BgChipBrush}" BorderBrush="{DynamicResource OverlayBorderBrush}"
                        BorderThickness="1" Padding="{Binding $parent[Window].DataContext.OverlayPreviewBlockPadding}"
                        PointerPressed="OnBlockPointerPressed" PointerMoved="OnBlockPointerMoved"
                        PointerReleased="OnBlockPointerReleased" PointerCaptureLost="OnBlockPointerCaptureLost"
                        DoubleTapped="OnBlockDoubleTapped" Cursor="SizeAll">
                  <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding}">
                      <MenuItem Header="Editar conteúdo" Click="OnEditBlockContentClick" />
                      <MenuItem Header="Remover bloco" Click="OnRemoveBlockClick" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextOverlaySecondaryBrush}"
                               FontSize="{Binding $parent[Window].DataContext.OverlayPreviewNameFontSize}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Content}">
                      <ItemsControl.DataTemplates>
                        <DataTemplate DataType="vm:OverlayMetricViewModel">
                          <StackPanel Spacing="2" Margin="{Binding $parent[Window].DataContext.OverlayPreviewRowMargin}">
                            <TextBlock Text="{Binding Name}" IsVisible="{Binding ShowName}" Foreground="{DynamicResource TextOverlaySecondaryBrush}"
                                       FontSize="{Binding $parent[Window].DataContext.OverlayPreviewNameFontSize}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="{Binding $parent[Window].DataContext.OverlayPreviewValueFontSize}"
                                       FontFamily="monospace" TextWrapping="WrapWithOverflow" />
                            <charts:HistoryChart IsVisible="{Binding ShowFrametimeGraph}"
                                                 Values="{Binding $parent[Window].DataContext.FrametimeSamples}"
                                                 Stroke="{Binding $parent[Window].DataContext.OverlayAccentBrush}"
                                                 GuideBrush="{DynamicResource OverlayGuideBrush}"
                                                 MinY="0" MaxFloor="33.3" GuideAt="16.66"
                                                 Height="{Binding $parent[Window].DataContext.OverlayPreviewFrametimeGraphHeight}" />
                          </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="vm:OverlayGraphRowViewModel">
                          <charts:HistoryChart Values="{Binding Samples}" Stroke="{Binding Stroke}"
                                               MinY="{Binding MinY}" MaxY="{Binding MaxY}" Height="{Binding Height}" />
                        </DataTemplate>
                        <DataTemplate DataType="vm:OverlayFrametimeGraphViewModel">
                          <charts:HistoryChart Values="{Binding Owner.FrametimeSamples}"
                                               Stroke="{Binding Owner.OverlayAccentBrush}"
                                               GuideBrush="{DynamicResource OverlayGuideBrush}"
                                               MinY="0" MaxFloor="33.3" GuideAt="16.66"
                                               Height="{Binding Owner.OverlayPreviewFrametimeGraphHeight}" />
                        </DataTemplate>
                        <DataTemplate DataType="vm:OverlayTemplateRowViewModel">
                          <TextBlock Text="{Binding Text}" Foreground="{Binding TextBrush}" IsVisible="{Binding IsVisible}"
                                     FontSize="{Binding $parent[Window].DataContext.OverlayPreviewValueFontSize}"
                                     FontFamily="monospace" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </ItemsControl.DataTemplates>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </ScrollViewer>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
      <TextBlock Text="A posição é relativa à janela monitorada. O overlay acompanha a janela ativa no Windows; no Linux, a posição depende do compositor."
                 Classes="muted" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Fechar" Click="OnCloseClick" />
      <Button Grid.Column="2" Classes="action" Content="Salvar e aplicar" Click="OnSaveSettingsClick" />
    </Grid>
  </Grid>
</Window>
