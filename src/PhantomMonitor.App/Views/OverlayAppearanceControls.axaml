<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhantomMonitor.App.Views.OverlayAppearanceControls">
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <StackPanel Spacing="5">
        <TextBlock Text="LARGURA (140–700 PX)" Foreground="{DynamicResource TextLabelBrush}" FontSize="9" FontWeight="Bold" />
        <TextBox Text="{Binding OverlayWidthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="5">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="OPACIDADE GERAL" Foreground="{DynamicResource TextLabelBrush}" FontSize="9" FontWeight="Bold" />
          <TextBlock Grid.Column="1" Text="{Binding OverlayOpacityLabel}" Foreground="{DynamicResource TextMonoBrush}" FontSize="10" />
        </Grid>
        <Slider Minimum="10" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                Value="{Binding OverlayOpacityPercent, Mode=TwoWay}" />
      </StackPanel>
    </Grid>
    <StackPanel Spacing="5">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
        <TextBlock Text="COR DO FUNDO" Foreground="{DynamicResource TextLabelBrush}" FontSize="9" FontWeight="Bold" />
        <Border Grid.Column="1" Width="26" Height="22" CornerRadius="3"
                Background="{Binding OverlayPreviewBackgroundBrush}" BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="1" />
        <Button Grid.Column="2" Content="Tema" Padding="6,2" Click="OnResetBackgroundColorClick" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Text="{Binding OverlayBackgroundColorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="#RRGGBB" />
        <TextBlock Grid.Column="1" Text="HEX" Foreground="{DynamicResource TextMonoBrush}" FontSize="9" VerticalAlignment="Center" />
      </Grid>
      <ItemsControl ItemsSource="{Binding OverlayColorSwatches}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Width="20" Height="20" MinWidth="20" Padding="0" Margin="2"
                    Tag="{Binding Hex}" Background="{Binding Brush}"
                    BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="1"
                    ToolTip.Tip="{Binding Hex}" Click="OnBackgroundColorSwatchClick" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <StackPanel Spacing="5">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="OPACIDADE DO FUNDO" Foreground="{DynamicResource TextLabelBrush}" FontSize="9" FontWeight="Bold" />
        <TextBlock Grid.Column="1" Text="{Binding OverlayBackgroundOpacityLabel}" Foreground="{DynamicResource TextMonoBrush}" FontSize="10" />
      </Grid>
      <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
              Value="{Binding OverlayBackgroundOpacityPercent, Mode=TwoWay}" />
    </StackPanel>
    <StackPanel Spacing="5">
      <TextBlock Text="FAMÍLIA DA FONTE" Foreground="{DynamicResource TextLabelBrush}" FontSize="9" FontWeight="Bold" />
      <ComboBox ItemsSource="{Binding OverlayFontFamilyOptions}"
                SelectedItem="{Binding OverlayFontFamilySelection, Mode=TwoWay}"
                MaxDropDownHeight="240" />
      <TextBox Text="{Binding OverlayFontFamilyCustomText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="Ou digite o nome da fonte" />
    </StackPanel>
    <StackPanel Spacing="5">
      <CheckBox Content="Exibir borda" IsChecked="{Binding OverlayBorderEnabled, Mode=TwoWay}" />
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsEnabled="{Binding OverlayBorderEnabled}">
        <TextBlock Text="COR DA BORDA" Foreground="{DynamicResource TextLabelBrush}" FontSize="9" FontWeight="Bold" />
        <Border Grid.Column="1" Width="26" Height="22" CornerRadius="3"
                Background="{Binding OverlayPreviewBorderBrush}" BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="1" />
        <Button Grid.Column="2" Content="Tema" Padding="6,2" Click="OnResetBorderColorClick" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsEnabled="{Binding OverlayBorderEnabled}">
        <TextBox Text="{Binding OverlayBorderColorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="#RRGGBB" />
        <TextBlock Grid.Column="1" Text="HEX" Foreground="{DynamicResource TextMonoBrush}" FontSize="9" VerticalAlignment="Center" />
      </Grid>
      <ItemsControl ItemsSource="{Binding OverlayColorSwatches}" IsEnabled="{Binding OverlayBorderEnabled}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Width="20" Height="20" MinWidth="20" Padding="0" Margin="2"
                    Tag="{Binding Hex}" Background="{Binding Brush}"
                    BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="1"
                    ToolTip.Tip="{Binding Hex}" Click="OnBorderColorSwatchClick" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <StackPanel Spacing="5">
        <TextBlock Text="FONTE (8–20 PT)" Foreground="{DynamicResource TextLabelBrush}" FontSize="9" FontWeight="Bold" />
        <TextBox Text="{Binding OverlayFontSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding OverlayFontSizeLabel}" Foreground="{DynamicResource TextMonoBrush}"
                 FontSize="10" VerticalAlignment="Bottom" Margin="0,0,0,8" />
    </Grid>
    <Slider Minimum="8" Maximum="20" TickFrequency="0.5" IsSnapToTickEnabled="True"
            Value="{Binding OverlayFontSizeSlider, Mode=TwoWay}" />
    <CheckBox Content="Modo compacto" IsChecked="{Binding OverlayCompactModeSetting, Mode=TwoWay}" />
  </StackPanel>
</UserControl>
