<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhantomMonitor.App.ViewModels"
        x:Class="PhantomMonitor.App.Views.OverlayBlockContentDialog"
        Title="Conteúdo do bloco"
        Width="700" Height="760" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="18" Spacing="12">
      <TextBlock Text="CONTEÚDO DO BLOCO" FontSize="17" FontWeight="SemiBold" />
      <TextBlock Text="Marque vários itens para reuni-los neste bloco." FontSize="11" TextWrapping="Wrap" Classes="muted" />

      <TextBlock Text="ORDEM NO BLOCO" FontSize="10" FontWeight="Bold" />
      <ListBox ItemsSource="{Binding OrderedContentItems}"
               SelectedItem="{Binding SelectedContentItem, Mode=TwoWay}"
               Height="150" MinHeight="70">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:OverlayBlockItemChoiceViewModel}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="4,2">
              <TextBlock Text="{Binding Kind}" Classes="muted" FontSize="9" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Mover para cima" IsEnabled="{Binding CanMoveContentUp}" Click="OnMoveContentUpClick" />
        <Button Content="Mover para baixo" IsEnabled="{Binding CanMoveContentDown}" Click="OnMoveContentDownClick" />
        <Button Content="Remover da lista" Click="OnRemoveContentClick" />
      </StackPanel>

      <StackPanel IsVisible="{Binding CanEditSelectedContent}" Spacing="8">
        <TextBlock Text="EDITAR LINHA DO SENSOR" FontSize="10" FontWeight="Bold" />
        <ComboBox ItemsSource="{Binding MetricChoices}"
                  SelectedItem="{Binding SelectedMetric, Mode=TwoWay}"
                  IsVisible="{Binding HasMetricChoices}" />
        <TextBlock Text="Nenhuma linha de sensor disponível para este item agora."
                   Classes="muted" IsVisible="{Binding NoMetricChoices}" />
        <StackPanel IsVisible="{Binding HasMetricChoices}" Spacing="8">
          <TextBox PlaceholderText="Nome exibido (vazio usa o nome atual)"
                   Text="{Binding MetricDisplayName, UpdateSourceTrigger=PropertyChanged}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <StackPanel Spacing="3">
              <TextBlock Text="CASAS DECIMAIS" FontSize="9" />
              <ComboBox ItemsSource="{Binding MetricDecimalsOptions}"
                        SelectedItem="{Binding MetricDecimals, Mode=TwoWay}"
                        IsEnabled="{Binding CanEditMetricDecimals}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="3">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="COR DO TEXTO" FontSize="9" />
                <Button Grid.Column="1" Content="Padrão" Padding="6,2" Click="OnResetMetricColorClick" />
              </Grid>
              <TextBox PlaceholderText="#RRGGBB" Text="{Binding MetricColor, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding ColorSwatches}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Width="20" Height="20" MinWidth="20" Padding="0" Margin="2"
                        Tag="{Binding Hex}" Background="{Binding Brush}"
                        BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="1"
                        ToolTip.Tip="{Binding Hex}" Click="OnMetricColorSwatchClick" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding MetricEditorMessage}" Classes="muted" />
          <Button Content="Aplicar ajuste à linha" HorizontalAlignment="Left" Click="OnSaveMetricOverrideClick" />
        </StackPanel>
      </StackPanel>

      <TextBlock Text="ADICIONAR CONTEÚDO" FontSize="10" FontWeight="Bold" />
      <TextBlock Text="Os itens marcados entram no final da lista acima. Você pode reorganizar a ordem depois."
                 FontSize="11" TextWrapping="Wrap" Classes="muted" />
      <ItemsControl ItemsSource="{Binding CategoriesChoices}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:OverlayBlockContentChoiceViewModel}">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,18,6" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <CheckBox Content="{Binding FrametimeChoice.Label}" IsChecked="{Binding FrametimeChoice.IsSelected}" />

      <TextBlock Text="SÉRIES" FontSize="10" FontWeight="Bold" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <ComboBox ItemsSource="{Binding SeriesCategories}"
                  SelectedItem="{Binding SelectedSeriesCategory, Mode=TwoWay}"
                  MinWidth="180" HorizontalAlignment="Stretch" />
        <CheckBox Grid.Column="1" Content="Selecionar todas as séries exibidas"
                  IsThreeState="True"
                  IsChecked="{Binding SeriesCategorySelectionState, Mode=OneWay}"
                  Click="OnToggleSeriesCategoryClick"
                  VerticalAlignment="Center" />
      </Grid>
      <ItemsControl ItemsSource="{Binding SeriesChoices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:OverlayBlockContentChoiceViewModel}">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Nenhuma série encontrada nesta categoria."
                 Classes="muted"
                 IsVisible="{Binding NoSeriesChoices}" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox PlaceholderText="Série ou padrão (ex.: Gpu* ou DiskRead#1)" Text="{Binding SeriesPatternInput, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Column="1" Content="Adicionar padrão" Click="OnAddSeriesPatternClick" />
      </Grid>

      <TextBlock Text="GRÁFICOS" FontSize="10" FontWeight="Bold" />
      <ItemsControl ItemsSource="{Binding GraphChoices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:OverlayBlockContentChoiceViewModel}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
              <Button Grid.Column="1" Content="Editar" Padding="10,4" Click="OnEditGraphClick" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBox PlaceholderText="Série (ex.: GpuTemperature#1)" Text="{Binding GraphSeries, UpdateSourceTrigger=PropertyChanged}" />
      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
        <StackPanel Spacing="3"><TextBlock Text="ALTURA" FontSize="9" /><TextBox Text="{Binding GraphHeight, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
        <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="AMOSTRAS" FontSize="9" /><TextBox Text="{Binding GraphWindow, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
        <StackPanel Grid.Column="2" Spacing="3"><TextBlock Text="MÍN." FontSize="9" /><TextBox PlaceholderText="Auto" Text="{Binding GraphMin, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
        <StackPanel Grid.Column="3" Spacing="3"><TextBlock Text="MÁX." FontSize="9" /><TextBox PlaceholderText="Auto" Text="{Binding GraphMax, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
      </Grid>
      <TextBox PlaceholderText="Cor opcional #RRGGBB" Text="{Binding GraphColor, UpdateSourceTrigger=PropertyChanged}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Novo gráfico" Click="OnNewGraphClick" />
        <Button Content="Salvar gráfico" Click="OnSaveGraphClick" />
        <Button Content="Remover selecionado" Click="OnRemoveGraphClick" />
      </StackPanel>

      <TextBlock Text="TEMPLATES" FontSize="10" FontWeight="Bold" />
      <ItemsControl ItemsSource="{Binding TemplateChoices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:OverlayBlockContentChoiceViewModel}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
              <Button Grid.Column="1" Content="Editar" Padding="10,4" Click="OnEditTemplateClick" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBox PlaceholderText="Texto com placeholders, ex.: GPU {GpuTemperature:F0} °C" Text="{Binding TemplateText, UpdateSourceTrigger=PropertyChanged}" />
      <TextBox PlaceholderText="Cor opcional #RRGGBB" Text="{Binding TemplateColor, UpdateSourceTrigger=PropertyChanged}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Novo template" Click="OnNewTemplateClick" />
        <Button Content="Salvar template" Click="OnSaveTemplateClick" />
        <Button Content="Remover selecionado" Click="OnRemoveTemplateClick" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
        <Button Content="Cancelar" Click="OnCancelClick" />
        <Button Content="Aplicar conteúdo" Click="OnApplyClick" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
