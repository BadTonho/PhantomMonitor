<Window x:Class="PhantomMonitor.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnóstico" Height="600" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117" Foreground="#E6EDF3">
    <Grid Margin="12">
        <TabControl Background="#0D1117" Foreground="#E6EDF3">
            <TabItem Header="Sensores e fontes">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Sensores Detectados" FontSize="15" FontWeight="Bold" Foreground="#1E90FF"/>
                        <TextBlock Text="Selecione e copie (Ctrl+A, Ctrl+C)" FontSize="10" Foreground="#8B98AA" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#0D1B2A" Padding="10" BorderBrush="#1A3A5C" BorderThickness="1" CornerRadius="6">
                        <TextBox x:Name="DebugTextBox" FontFamily="Consolas" FontSize="11"
                                 Foreground="#E6EDF3" Background="Transparent" BorderThickness="0" IsReadOnly="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.ScrollChanged="OnDebugScrollChanged" Padding="4"/>
                    </Border>

                    <TextBlock x:Name="LastUpdateText" Grid.Row="2" Text="Aguardando dados..." FontSize="10"
                               Foreground="#8B98AA" Margin="0,6,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Erros do aplicativo">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Registros locais recentes" FontSize="15" FontWeight="Bold" Foreground="#1E90FF"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Atualizar" Click="OnRefreshErrors" Margin="0,0,8,0" Padding="10,4"/>
                            <Button Content="Abrir arquivo de erros" Click="OnOpenErrorLog" Padding="10,4"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="ErrorLogPathText" Grid.Row="1" FontSize="10" Foreground="#8B98AA"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Border Grid.Row="2" Background="#0D1B2A" Padding="8" BorderBrush="#1A3A5C" BorderThickness="1" CornerRadius="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ErrorEntriesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#243345" BorderThickness="0,0,0,1" Padding="4,8">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding TimestampText}" FontSize="10" Foreground="#93C5FD"/>
                                                    <TextBlock Text="{Binding Context}" FontSize="10" Foreground="#FBBF24"
                                                               FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Message}" FontSize="10" Foreground="#E6EDF3"
                                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock x:Name="ErrorLogStatusText" Grid.Row="3" Text="Nenhum erro registrado."
                               FontSize="10" Foreground="#8B98AA" Margin="0,6,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
