<Window x:Class="RivaMonitor.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sensores Detectados" Height="550" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117" Foreground="#E6EDF3">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sensores Detectados"
                   FontSize="15" FontWeight="Bold" Foreground="#1E90FF" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" Text="Selecione e copie (Ctrl+A, Ctrl+C)"
                   FontSize="10" Foreground="#666" Margin="0,18,0,4" HorizontalAlignment="Right"/>

        <Border Grid.Row="1" Background="#0D1B2A" Padding="10"
                BorderBrush="#1A3A5C" BorderThickness="1" CornerRadius="6">
            <TextBox x:Name="DebugTextBox" FontFamily="Consolas" FontSize="11"
                     Foreground="#E6EDF3" Background="Transparent"
                     BorderThickness="0" IsReadOnly="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.ScrollChanged="OnDebugScrollChanged"
                     Padding="4"/>
        </Border>

        <TextBlock x:Name="LastUpdateText" Grid.Row="2"
                   Text="Aguardando dados..." FontSize="10"
                   Foreground="#666" Margin="0,6,0,0"/>
    </Grid>
</Window>
