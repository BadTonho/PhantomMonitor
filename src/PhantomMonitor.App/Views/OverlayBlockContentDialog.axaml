<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:charts="using:PhantomMonitor.App.Controls"
        xmlns:vm="using:PhantomMonitor.App.ViewModels"
        x:Class="PhantomMonitor.App.Views.OverlayBlockContentDialog"
        Title="Conteúdo do bloco"
        Width="980" Height="760" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}">
  <Grid Margin="18" RowDefinitions="*,Auto" RowSpacing="12">
    <Grid Grid.Row="0" ColumnDefinitions="1*,1.35*" ColumnSpacing="16">
      <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <TextBlock Text="ORDEM NO BLOCO" FontSize="10" FontWeight="Bold" />
        <ListBox Grid.Row="1" x:Name="ContentItemsList"
                 ItemsSource="{Binding OrderRows}"
                 SelectedItem="{Binding SelectedOrderRow, Mode=TwoWay}"
                 MinHeight="120" VerticalAlignment="Stretch">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:OverlayBlockOrderRowViewModel}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="4,2">
                <TextBlock Text="{Binding Kind}" Classes="muted" FontSize="9" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" IsVisible="{Binding IsGroup}" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="14,0,0,0" IsVisible="{Binding IsMetric}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Grid.Row="2" Orientation="Horizontal">
          <Button Content="Mover para cima" IsEnabled="{Binding CanMoveContentUp}" Click="OnMoveContentUpClick" Margin="0,0,8,8" />
          <Button Content="Mover para baixo" IsEnabled="{Binding CanMoveContentDown}" Click="OnMoveContentDownClick" Margin="0,0,8,8" />
          <Button Content="Remover da lista" IsEnabled="{Binding CanRemoveSelectedContent}" Click="OnRemoveContentClick" Margin="0,0,8,8" />
        </WrapPanel>
      </Grid>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Spacing="8">
          <TextBlock Text="EDITAR LINHA DO SENSOR" FontSize="10" FontWeight="Bold"
                     IsVisible="{Binding HasSelectedMetric}" />
          <TextBlock Text="Selecione uma categoria ou série na lista para editar sua apresentação."
                     Classes="muted" TextWrapping="Wrap" IsVisible="{Binding ShowMetricEditorHint}" />
          <TextBlock Text="Nenhuma linha de sensor disponível para este item agora."
                     Classes="muted" IsVisible="{Binding NoMetricChoices}" />
          <StackPanel IsVisible="{Binding HasSelectedMetric}" Spacing="8">
            <TextBox PlaceholderText="Nome exibido (vazio usa o nome atual)"
                     Text="{Binding MetricDisplayName, UpdateSourceTrigger=PropertyChanged}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <StackPanel Spacing="3">
                <TextBlock Text="CASAS DECIMAIS" FontSize="9" />
                <ComboBox ItemsSource="{Binding MetricDecimalsOptions}"
                          SelectedItem="{Binding MetricDecimals, Mode=TwoWay}"
                          IsEnabled="{Binding CanEditMetricDecimals}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="3">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="COR DO TEXTO" FontSize="9" />
                  <Button Grid.Column="1" Content="Padrão" Padding="6,2" Click="OnResetMetricColorClick" />
                </Grid>
                <TextBox PlaceholderText="#RRGGBB" Text="{Binding MetricColor, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding ColorSwatches}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Width="20" Height="20" MinWidth="20" Padding="0" Margin="2"
                          Tag="{Binding Hex}" Background="{Binding Brush}"
                          BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="1"
                          ToolTip.Tip="{Binding Hex}" Click="OnMetricColorSwatchClick" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding MetricEditorMessage}" Classes="muted" />
            <Button Content="Aplicar ajuste à linha" HorizontalAlignment="Left" Click="OnSaveMetricOverrideClick" />
          </StackPanel>
          <StackPanel Spacing="6" Margin="0,16,0,0">
            <TextBlock Text="PRÉVIA DO BLOCO" FontSize="10" FontWeight="Bold" />
            <Border Width="{Binding OverlayPreviewWidth}"
                    Opacity="{Binding OverlayPreviewOpacity}"
                    Background="{Binding Owner.OverlayPreviewBackgroundBrush}"
                    BorderBrush="{Binding Owner.OverlayPreviewBorderBrush}"
                    BorderThickness="{Binding Owner.OverlayPreviewBorderThickness}"
                    Padding="{Binding Owner.OverlayPreviewBlockPadding}"
                    CornerRadius="5" HorizontalAlignment="Left">
              <StackPanel Spacing="{Binding Owner.OverlayPreviewContentSpacing}">
                <TextBlock Text="{Binding PreviewTitle}" Foreground="{DynamicResource TextOverlaySecondaryBrush}"
                           FontFamily="{Binding Owner.OverlayPreviewNameFontFamily}"
                           FontSize="{Binding Owner.OverlayPreviewNameFontSize}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding PreviewRows}">
                  <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:OverlayBlockMetricViewModel">
                      <StackPanel Spacing="2" Margin="{Binding $parent[Window].DataContext.Owner.OverlayPreviewRowMargin}">
                        <TextBlock Text="{Binding Name}" IsVisible="{Binding ShowName}" Foreground="{Binding NameForeground}"
                                   FontFamily="{Binding $parent[Window].DataContext.Owner.OverlayPreviewNameFontFamily}"
                                   FontSize="{Binding $parent[Window].DataContext.Owner.OverlayPreviewNameFontSize}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Value}" Foreground="{Binding ValueForeground}"
                                   FontFamily="{Binding $parent[Window].DataContext.Owner.OverlayPreviewValueFontFamily}"
                                   FontSize="{Binding $parent[Window].DataContext.Owner.OverlayPreviewValueFontSize}" TextWrapping="WrapWithOverflow" />
                        <charts:HistoryChart IsVisible="{Binding ShowFrametimeGraph}"
                                             Values="{Binding $parent[Window].DataContext.Owner.FrametimeSamples}"
                                             Stroke="{Binding $parent[Window].DataContext.Owner.OverlayAccentBrush}"
                                             GuideBrush="{DynamicResource OverlayGuideBrush}"
                                             MinY="0" MaxFloor="33.3" GuideAt="16.66"
                                             Height="{Binding $parent[Window].DataContext.Owner.OverlayPreviewFrametimeGraphHeight}" />
                      </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="vm:OverlayGraphRowViewModel">
                      <charts:HistoryChart Values="{Binding Samples}" Stroke="{Binding Stroke}"
                                           MinY="{Binding MinY}" MaxY="{Binding MaxY}" Height="{Binding Height}" />
                    </DataTemplate>
                    <DataTemplate DataType="vm:OverlayFrametimeGraphViewModel">
                      <charts:HistoryChart Values="{Binding Owner.FrametimeSamples}"
                                           Stroke="{Binding Owner.OverlayAccentBrush}"
                                           GuideBrush="{DynamicResource OverlayGuideBrush}"
                                           MinY="0" MaxFloor="33.3" GuideAt="16.66"
                                           Height="{Binding Owner.OverlayPreviewFrametimeGraphHeight}" />
                    </DataTemplate>
                    <DataTemplate DataType="vm:OverlayTemplateRowViewModel">
                      <TextBlock Text="{Binding Text}" Foreground="{Binding TextBrush}" IsVisible="{Binding IsVisible}"
                                 FontFamily="{Binding $parent[Window].DataContext.Owner.OverlayPreviewValueFontFamily}"
                                 FontSize="{Binding $parent[Window].DataContext.Owner.OverlayPreviewValueFontSize}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                    <DataTemplate DataType="vm:OverlayBlockPreviewTextViewModel">
                      <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="{Binding $parent[Window].DataContext.Owner.OverlayPreviewValueFontSize}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ItemsControl.DataTemplates>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <Button Content="Adicionar conteúdo…" HorizontalAlignment="Left" Click="OnOpenContentPickerClick" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Cancelar" Click="OnCancelClick" />
        <Button Content="Aplicar conteúdo" Click="OnApplyClick" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
