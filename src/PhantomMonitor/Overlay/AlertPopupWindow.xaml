<Window x:Class="PhantomMonitor.Overlay.AlertPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phantom Monitor — Alerta"
        Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="False">
    <Border Background="#F20F1117" CornerRadius="8" Padding="14,12"
            BorderBrush="#F59E0B" BorderThickness="1">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="14" Foreground="#F59E0B" Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Text="Phantom Monitor — Alerta"
                           FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           MaxWidth="320"/>
            </StackPanel>
            <TextBlock x:Name="MessageText" Text="" FontSize="11" Foreground="#CBD5E1"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock Text="Clique para fechar" FontSize="9" Foreground="#64748B"
                       Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>
