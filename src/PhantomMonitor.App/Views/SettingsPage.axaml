<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            x:Class="PhantomMonitor.App.Views.SettingsPage">
    <UserControl.Styles>
      <Style Selector="Button.settings-help-icon">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
      </Style>
      <Style Selector="Button.settings-help-icon:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsSettings}">
      <StackPanel Margin="28,23,28,28" Spacing="16">
        <Border IsVisible="{Binding HasConfigurationWarning}" Background="{DynamicResource BgTintWarmBrush}"
                BorderBrush="{DynamicResource BorderTintWarmBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
          <TextBlock Text="{Binding ConfigurationWarning}" Foreground="{DynamicResource AccentWarningBrush}" TextWrapping="Wrap" />
        </Border>
        <StackPanel Spacing="4" Margin="0,0,0,3">
          <TextBlock Text="Configurações" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="Ajuste a coleta, o overlay e os arquivos de telemetria." Classes="muted" FontSize="11" />
        </StackPanel>

        <Border Classes="desktop-card">
          <StackPanel Spacing="12">
            <TextBlock Text="COLETA" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="Intervalo global (milissegundos)" Foreground="{DynamicResource TextBodyBrush}" FontSize="12" />
            <TextBox Classes="settings-input" Text="{Binding UpdateIntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock IsVisible="{Binding IsLegacyIntervalOutOfRange}" Text="O config atual usa mais de 60.000 ms. Esse valor será mantido até você editar o intervalo." Foreground="{DynamicResource AccentWarningBrush}" FontSize="11" TextWrapping="Wrap" />
            <Button Classes="settings-help-icon" AutomationProperties.Name="Ajuda da seção COLETA">
              <ToolTip.Tip>
                <TextBlock Text="Define o intervalo de coleta, de 100 a 60.000 ms. Intervalos menores atualizam o painel com mais frequência."
                           MaxWidth="420" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
              </ToolTip.Tip>
              <Grid Width="16" Height="16">
                <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                <TextBlock Text="i" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,-1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Grid>
            </Button>
          </StackPanel>
        </Border>

        <Border Classes="desktop-card">
          <StackPanel Spacing="12">
            <TextBlock Text="MODO DO OVERLAY" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
            <ComboBox ItemsSource="{Binding OverlayRenderModeOptions}"
                      SelectedIndex="{Binding OverlayRenderModeIndex, Mode=TwoWay}"
                      HorizontalAlignment="Left" MinWidth="240" />
            <TextBlock IsVisible="{Binding IsOverlayInGameModeSelected}" Text="{Binding InGameOverlayCapabilityNotice}" Foreground="{DynamicResource AccentWarningBrush}" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="ATALHO GLOBAL DO OVERLAY" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
            <WrapPanel>
              <Button x:Name="OverlayHotkeyButton" Content="{Binding OverlayHotkeyButtonText}" Click="OnCaptureOverlayHotkeyClick" IsEnabled="{Binding !IsSavingSettings}" Margin="0,0,8,8" />
              <Button Content="Limpar atalho" Click="OnClearOverlayHotkeyClick" IsEnabled="{Binding !IsSavingSettings}" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock Text="{Binding OverlayHotkeyStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <Button Classes="action accent" Content="Abrir editor do overlay" Click="OnOpenOverlayEditorClick" />
            <StackPanel IsVisible="{Binding IsOverlayInGameModeSelected}" Spacing="8">
              <Border Background="{DynamicResource BgWindowBrush}" BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel Spacing="5">
                  <TextBlock Text="DIAGNÓSTICO DO OVERLAY" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
                  <TextBlock Text="{Binding InGameOverlayDiagnosticText}" Foreground="{DynamicResource TextBodyBrush}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding OverlayTargetPathText, Mode=TwoWay}" PlaceholderText="Caminho do executável" />
                <TextBox Grid.Column="1" Text="{Binding OverlayTargetArgumentsText, Mode=TwoWay}" PlaceholderText="Argumentos (opcional)" />
                <Button Grid.Column="2" Content="Adicionar" Click="OnAddOverlayTargetClick" />
              </Grid>
              <ItemsControl ItemsSource="{Binding OverlayInGameTargets}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                      <TextBlock Text="{Binding ExecutablePath}" Foreground="{DynamicResource TextBodyBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="1" IsVisible="{Binding $parent[UserControl].DataContext.IsOverlayTargetLaunchVisible}" Content="Iniciar" Click="OnLaunchOverlayTargetClick" />
                      <Button Grid.Column="2" Content="Remover" Click="OnRemoveOverlayTargetClick" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel IsVisible="{Binding IsLinuxPlatform}" Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding SteamOverlayLaunchOption}" IsReadOnly="True" MinWidth="260" />
                <Button Content="Copiar opção Steam" Click="OnCopySteamOverlayOptionClick" />
              </StackPanel>
              <TextBlock Text="{Binding OverlayTargetMessage}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <Button Classes="settings-help-icon" AutomationProperties.Name="Ajuda da seção MODO DO OVERLAY">
              <ToolTip.Tip>
                <StackPanel MaxWidth="420" Spacing="6">
                  <TextBlock Text="Janela flutuante mantém os blocos em janelas separadas. Dentro do jogo usa um renderer nativo e depende do suporte da API gráfica; anti-cheats podem bloqueá-lo. O atalho alterna o overlay e o editor ajusta os blocos."
                             TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="No Windows, o app detecta globalmente aplicações apresentando frames enquanto está aberto e tenta instalar o hook sem cadastro de executável, usando ETW/PresentMon. Pode exigir a conta no grupo Performance Log Users. Aplicações Vulkan já abertas precisam ser reiniciadas; jogos elevados podem ignorar registros por usuário. Anti-cheats podem recusar o hook. Para jogos D3D12 sem overlay, adicione o executável abaixo e use Iniciar."
                             TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="No Linux, adicione um executável para iniciá-lo com Vulkan e, se instalado, o preload OpenGL GLX/EGL. Para Steam, cole a opção gerada abaixo nas propriedades do jogo."
                             TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
              </ToolTip.Tip>
              <Grid Width="16" Height="16">
                <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                <TextBlock Text="i" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,-1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Grid>
            </Button>
          </StackPanel>
        </Border>

        <Border Classes="desktop-card">
          <StackPanel Spacing="12">
            <TextBlock Text="INTERFACE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
            <StackPanel Spacing="5">
              <TextBlock Text="TEMA VISUAL" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" ItemsSource="{Binding ThemeOptions}" MinWidth="260" HorizontalAlignment="Left" />
                <Button Content="Personalizar paleta" Click="OnOpenThemePaletteEditorClick" />
              </StackPanel>
            </StackPanel>
            <Button Classes="settings-help-icon" AutomationProperties.Name="Ajuda da seção INTERFACE">
              <ToolTip.Tip>
                <TextBlock Text="Neptune usa o visual original do Avalonia; Slate reproduz o visual do WPF. Escolha um tema e personalize as cores; as mudanças são aplicadas em ‘Salvar e aplicar’, sem reiniciar."
                           MaxWidth="420" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
              </ToolTip.Tip>
              <Grid Width="16" Height="16">
                <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                <TextBlock Text="i" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,-1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Grid>
            </Button>
          </StackPanel>
        </Border>

        <Border Classes="desktop-card">
          <StackPanel Spacing="12">
            <TextBlock Text="BETA" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
            <CheckBox Content="Mostrar Sensores customizados na barra lateral"
                      IsChecked="{Binding ShowCustomSensorsInSidebar, Mode=TwoWay}" />
            <CheckBox Content="Mostrar Ajuste por série na barra lateral"
                      IsChecked="{Binding ShowSensorTuningInSidebar, Mode=TwoWay}" />
            <CheckBox Content="Mostrar Alertas na barra lateral"
                      IsChecked="{Binding ShowAlertsInSidebar, Mode=TwoWay}" />
            <Button Classes="settings-help-icon" AutomationProperties.Name="Ajuda da seção BETA">
              <ToolTip.Tip>
                <TextBlock Text="Controla a exibição na barra lateral de Sensores customizados, Ajuste por série e Alertas. Cada escolha é salva imediatamente."
                           MaxWidth="420" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
              </ToolTip.Tip>
              <Grid Width="16" Height="16">
                <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                <TextBlock Text="i" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,-1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Grid>
            </Button>
          </StackPanel>
        </Border>

        <Border Classes="desktop-card">
          <StackPanel Spacing="12">
            <TextBlock Text="GRAVAÇÃO DE TELEMETRIA" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
            <CheckBox Content="Exportar CSV" IsChecked="{Binding LogToCsv, Mode=TwoWay}" />
            <CheckBox Content="Snapshot JSON mais recente" IsChecked="{Binding LogToJson, Mode=TwoWay}" />
            <CheckBox Content="Journal JSON contínuo (JSONL)" IsChecked="{Binding LogToJsonJournal, Mode=TwoWay}" />
            <StackPanel Spacing="4" Margin="0,6,0,0">
              <TextBlock Text="PASTA DOS ARQUIVOS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
              <TextBlock Text="{Binding LogDirectoryText}" Foreground="{DynamicResource TextMonoBrush}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <Button Classes="settings-help-icon" AutomationProperties.Name="Ajuda da seção GRAVAÇÃO DE TELEMETRIA">
              <ToolTip.Tip>
                <TextBlock Text="Escolha os formatos de telemetria que serão gravados. A pasta dos arquivos aparece no card."
                           MaxWidth="420" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
              </ToolTip.Tip>
              <Grid Width="16" Height="16">
                <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                <TextBlock Text="i" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,-1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Grid>
            </Button>
          </StackPanel>
        </Border>

        <Border Classes="desktop-card">
          <StackPanel Spacing="12">
            <TextBlock Text="EXPORTADOR HTTP" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
            <CheckBox Content="Ativar endpoints de telemetria" IsChecked="{Binding TelemetryExportEnabled, Mode=TwoWay}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="5">
                <TextBlock Text="PORTA (1024–65535)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
                <TextBox Text="{Binding TelemetryExportPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="7317" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="ENDPOINTS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding TelemetryExportEndpointText}" Foreground="{DynamicResource TextMonoBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
            <CheckBox Content="Escutar em todas as interfaces (LAN)" IsChecked="{Binding TelemetryExportListenAll, Mode=TwoWay}" />
            <TextBlock Text="A opção LAN permite acesso por outros dispositivos da rede e não usa TLS nem autenticação. Ative somente em uma rede confiável." Foreground="{DynamicResource AccentWarningBrush}" FontSize="11" TextWrapping="Wrap" />
            <StackPanel Spacing="4">
              <TextBlock Text="ESTADO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
              <TextBlock Text="{Binding TelemetryExportStatusText}" Foreground="{DynamicResource TextMonoBrush}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <Button Classes="settings-help-icon" AutomationProperties.Name="Ajuda da seção EXPORTADOR HTTP">
              <ToolTip.Tip>
                <TextBlock Text="GET /values retorna o snapshot JSON e GET /health verifica o listener. O serviço funciona durante a coleta e mantém o último snapshot durante a pausa."
                           MaxWidth="420" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
              </ToolTip.Tip>
              <Grid Width="16" Height="16">
                <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                <TextBlock Text="i" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,-1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Grid>
            </Button>
          </StackPanel>
        </Border>

        <Border Classes="desktop-card" IsVisible="{Binding StartupSupported}">
          <StackPanel Spacing="12">
            <TextBlock Text="INICIALIZAÇÃO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
            <CheckBox Content="Iniciar com o sistema"
                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
            <Button Classes="settings-help-icon" AutomationProperties.Name="Ajuda da seção INICIALIZAÇÃO">
              <ToolTip.Tip>
                <TextBlock Text="Ativa ou desativa a inicialização automática do PhantomMonitor ao entrar no sistema. A mudança é aplicada imediatamente."
                           MaxWidth="420" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
              </ToolTip.Tip>
              <Grid Width="16" Height="16">
                <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                <TextBlock Text="i" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,-1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Grid>
            </Button>
          </StackPanel>
        </Border>

        <Border Classes="desktop-card">
          <StackPanel Spacing="12">
            <TextBlock Text="ATUALIZAÇÕES (GITHUB RELEASES)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
            <CheckBox Content="Verificar automaticamente (no arranque e a cada 24h)" IsChecked="{Binding UpdateAutoCheck, Mode=TwoWay}" />
            <CheckBox Content="Canal beta (aceitar pré-releases do GitHub)" IsChecked="{Binding UpdateBetaChannel, Mode=TwoWay}" />
            <StackPanel Spacing="5">
              <TextBlock Text="REPOSITÓRIO (VAZIO USA O OFICIAL)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
              <TextBox Text="{Binding UpdateRepositoryText, Mode=TwoWay}" PlaceholderText="BadTonho/PhantomMonitor" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="ESTADO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
              <TextBlock Text="{Binding UpdateVersionText}" Foreground="{DynamicResource TextMonoBrush}" FontSize="11" TextWrapping="Wrap" />
              <TextBlock Text="{Binding UpdateStatusText}" Foreground="{DynamicResource TextMonoBrush}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="action accent" Content="Buscar agora" Click="OnCheckUpdatesClick" />
              <Button Content="Abrir página de releases" Click="OnOpenReleasesPageClick" />
              <Button Content="{Binding UpdateButtonText}" Click="OnApplyUpdateClick"
                      IsVisible="{Binding CanApplyUpdate}" IsEnabled="{Binding CanApplyUpdateEnabled}" />
            </StackPanel>
            <Button Classes="settings-help-icon" AutomationProperties.Name="Ajuda da seção ATUALIZAÇÕES">
              <ToolTip.Tip>
                <TextBlock Text="Configura a checagem automática, o canal de pré-lançamentos e o repositório. A atualização baixa a nova versão, reabre o app e preserva configurações e logs; instalações por pacote do sistema não oferecem essa troca."
                           MaxWidth="420" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
              </ToolTip.Tip>
              <Grid Width="16" Height="16">
                <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                <TextBlock Text="i" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,-1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Grid>
            </Button>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding SettingsMessage}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
</UserControl>
