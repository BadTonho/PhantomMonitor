{
  "updateIntervalMs": 1000,
  "logToCsv": false,
  "logToJson": true,
  "showOverlay": false,
  "toggleOverlayHotkey": "",
  "overlayOpacity": 0.85,
  "overlayPosition": {
    "x": 20,
    "y": 80
  },
  "overlay": {
    "width": 220,
    "showCpu": true,
    "showGpu": true,
    "showRam": true,
    "showDisk": true,
    "showNetwork": false,
    "showGpuProcesses": false,
    "showFans": true,
    "showMotherboard": false,
    "showFps": true,
    "showFrametimeGraph": true,
    "compactMode": false,
    "accentColor": "#1E90FF",
    "fontSize": 11.5,
    "shownSeries": ["Gpu*", "FanSpeed*", "Disk*"]
  },
  "sensors": {
    "cpu": true,
    "gpu": true,
    "ram": true,
    "disk": true,
    "network": false,
    "motherboard": false
  },
  "profiles": [],
  "alerts": {
    "enabled": true,
    "cooldownSeconds": 60,
    "allowShutdown": false,
    "rules": [
      {
        "enabled": false,
        "sensor": "CpuTemperature",
        "comparison": "Above",
        "threshold": 90,
        "cooldownSeconds": 60,
        "popup": true,
        "sound": true,
        "script": "",
        "scriptArguments": "",
        "shutdown": false,
        "message": "CPU em {value} °C (limite {threshold} °C)"
      }
    ]
  }
}
