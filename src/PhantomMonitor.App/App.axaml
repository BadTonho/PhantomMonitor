<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhantomMonitor.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Tema builtin ativo, resolvido no boot por App.ApplyConfiguredUiTheme():
             config.json "uiTheme" (neptune|slate) e, em segundo lugar, a CLI
             ui-theme=<nome> (dois hífens como prefixo) sobrepõe (smoke/
             troubleshooting). Os dois dicionários têm a MESMA lista de chaves; as
             views usam DynamicResource. Troca em runtime pela UI chega na Fase 3. -->
        <ResourceInclude Source="avares://PhantomMonitor/Themes/Tokens.Neptune.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
