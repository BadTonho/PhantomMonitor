<Window x:Class="RivaMonitor.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RivaMonitor Overlay" Height="400" Width="280"
        WindowStyle="None" AllowsTransparency="True"
        Background="#CC0D1117" Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SizeToContent="Height"
        IsHitTestVisible="False"
        BorderThickness="1" BorderBrush="#1E90FF">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
            <TextBlock Text="RIVA" FontSize="11" FontWeight="Bold"
                       Foreground="#1E90FF"/>
            <TextBlock Text=" MONITOR" FontSize="11" FontWeight="Light"
                       Foreground="#888"/>
        </StackPanel>

        <ItemsControl x:Name="SensorList" Grid.Row="1"
                      FontFamily="Consolas" FontSize="11">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Foreground="#888"
                                   Grid.Column="0" Margin="0,0,6,0"/>
                        <Rectangle Grid.Column="1" Height="8" Margin="0,2"
                                   Fill="#1A1E3A" RadiusX="3" RadiusY="3"/>
                        <Rectangle Grid.Column="1" Height="8" Margin="0,2"
                                   Fill="{Binding BarColor}" RadiusX="3" RadiusY="3"
                                   HorizontalAlignment="Left"
                                   Width="{Binding BarWidth}"/>
                        <TextBlock Text="{Binding ValueText}" Foreground="#FFF"
                                   Grid.Column="2" Margin="6,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
