<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:charts="using:PhantomMonitor.App.Controls"
        xmlns:pages="using:PhantomMonitor.App.Views"
        x:Class="PhantomMonitor.App.Views.MainWindow"
        Title="Phantom Monitor"
        Width="1120" Height="790" MinWidth="850" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgWindowBrush}">
  <Window.Styles>
    <StyleInclude Source="avares://PhantomMonitor/Themes/DesktopStyles.axaml" />

    <Style Selector="TextBlock.metric">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.diagnostic-tab">
      <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BgCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Foreground" Value="{DynamicResource NavForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.diagnostic-tab:pointerover">
      <Setter Property="Background" Value="{DynamicResource NavSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NavForegroundSelectedBrush}" />
    </Style>
    <Style Selector="Button.diagnostic-tab.selected">
      <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NavForegroundSelectedBrush}" />
    </Style>
    <!-- Navegação da sidebar (porta do RadioButton do Styles.xaml do WPF): indicador
         3×14 com AccentLightBrush no selecionado, fundo/texto por tokens Nav*.
         Hover = NavSoftBrush, selecionado = NavSelectedBrush + SemiBold. -->
    <Style Selector="Button.nav">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource NavForegroundBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
              <Border x:Name="Indicator" Width="3" Height="14" CornerRadius="1.5" Margin="-2,0,7,0"
                      Background="{DynamicResource AccentLightBrush}" />
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.nav /template/ Border#Indicator">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.nav:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="{DynamicResource NavSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NavForegroundSelectedBrush}" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ Border#Indicator">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- Depois do :pointerover para o hover não sobrescrever o item selecionado. -->
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NavForegroundSelectedBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav.selected /template/ Border#Indicator">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- Badge de update (porta do chip verde do WPF na sidebar) -->
    <Style Selector="Button.update-badge">
      <Setter Property="Background" Value="{DynamicResource BgToastUpdateBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderTintGreenBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBox.settings-input">
      <Setter Property="Width" Value="190" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="ToggleButton.inventory-group">
      <Setter Property="Background" Value="{DynamicResource BgChipBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BgCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="*,Auto">
              <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
              <TextBlock x:Name="Arrow" Grid.Column="1" Foreground="{TemplateBinding Foreground}"
                         FontSize="15" VerticalAlignment="Center" Margin="12,0,2,0" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.inventory-group /template/ TextBlock#Arrow">
      <Setter Property="Text" Value="⌄" />
    </Style>
    <Style Selector="ToggleButton.inventory-group:checked /template/ TextBlock#Arrow">
      <Setter Property="Text" Value="⌃" />
    </Style>
    <Style Selector="ToggleButton.inventory-group:pointerover">
      <Setter Property="Background" Value="{DynamicResource NavSoftBrush}" />
    </Style>
    <Style Selector="ToggleButton.inventory-group:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
    </Style>
    <Style Selector="Button.inventory-row-toggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.inventory-row-toggle:pointerover">
      <Setter Property="Background" Value="{DynamicResource NavSoftBrush}" />
    </Style>
    <Style Selector="Button.inventory-row-toggle:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="230,*">
    <Border Grid.Column="0" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BgSidebarBorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="16,22">
        <StackPanel Spacing="3">
          <TextBlock Text="PHANTOM" Foreground="{DynamicResource TextBrightBrush}" FontSize="19" FontWeight="Bold" />
          <TextBlock Text="HARDWARE MONITOR" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,28,0,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="6">
          <TextBlock Text="MONITORAMENTO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="8,0,0,4" />
          <Button x:Name="NavOverview" Classes="nav" Click="OnOverviewClick" ToolTip.Tip="Visão geral">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Data="M 2,8 L 8,2 L 14,8 L 14,14 L 2,14 Z M 6,14 L 6,9 L 10,9 L 10,14" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
              <TextBlock Text="Visão geral" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavInventory" Classes="nav" Click="OnInventoryClick" ToolTip.Tip="Inventário">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Data="M 2,2 L 14,2 L 14,14 L 2,14 Z M 2,6 L 14,6 M 6,6 L 6,14" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
              <TextBlock Text="Inventário" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavCustomSensors" Classes="nav" Click="OnCustomSensorsClick" ToolTip.Tip="Sensores customizados"
                  IsVisible="{Binding ShowCustomSensorsInSidebar}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Data="M 2,12 L 5,8 L 8,10 L 12,3 L 14,4" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
              <TextBlock Text="Sensores customizados" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavSensorTuning" Classes="nav" Click="OnSensorTuningClick" ToolTip.Tip="Ajuste por série"
                  IsVisible="{Binding ShowSensorTuningInSidebar}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Data="M 2,4 L 14,4 M 2,8 L 14,8 M 2,12 L 14,12 M 5,2 L 5,6 M 11,6 L 11,10 M 7,10 L 7,14" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
              <TextBlock Text="Ajuste por série" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavAlerts" Classes="nav" Click="OnAlertsClick" ToolTip.Tip="Alertas"
                  IsVisible="{Binding ShowAlertsInSidebar}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Data="M 8,2 L 14,13 L 2,13 Z M 8,6 L 8,9 M 8,11 L 8,11.5" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
              <TextBlock Text="Alertas" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavDiagnostics" Classes="nav" Click="OnDiagnosticsClick" ToolTip.Tip="Diagnóstico">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Data="M 8,2 A 6,6 0 1 1 7.99,2 M 8,7 L 8,11 M 8,4.5 L 8,5" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
              <TextBlock Text="Diagnóstico" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavSettings" Classes="nav" Click="OnSettingsClick" ToolTip.Tip="Configurações">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Data="M 2,4 L 14,4 M 2,8 L 14,8 M 2,12 L 14,12 M 5,2 L 5,6 M 10,6 L 10,10 M 6,10 L 6,14" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
              <TextBlock Text="Configurações" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" CornerRadius="9" Padding="11">
          <StackPanel Spacing="5">
            <TextBlock Text="ESTADO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextStatusBrush}" FontSize="12" />
            <Button Classes="update-badge" IsVisible="{Binding UpdateBadgeVisible}" Click="OnUpdateBadgeClick">
              <TextBlock Text="{Binding UpdateBadgeText}" Foreground="{DynamicResource AccentGreenSoftBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Left" />
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsOverview}">
      <StackPanel Margin="28,23,28,28" Spacing="16">
        <Border IsVisible="{Binding HasConfigurationWarning}" Background="{DynamicResource BgTintWarmBrush}"
                BorderBrush="{DynamicResource BorderTintWarmBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
          <TextBlock Text="{Binding ConfigurationWarning}" Foreground="{DynamicResource AccentWarningBrush}" TextWrapping="Wrap" />
        </Border>
        <Grid RowDefinitions="Auto,Auto" Margin="0,0,0,3" RowSpacing="10">
          <StackPanel Spacing="4">
            <TextBlock Text="Visão geral do sistema" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding LastUpdateText}" Classes="muted" FontSize="11" />
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="action" Content="{Binding OverlayButtonText}" Click="OnToggleOverlayClick" />
            <Button Classes="action" Content="Iniciar" IsEnabled="{Binding CanStart}" Click="OnStartClick" />
            <Button Classes="action" Content="{Binding PauseButtonText}" IsEnabled="{Binding CanPause}" Click="OnPauseClick" />
            <Button Classes="action" Content="Parar" IsEnabled="{Binding CanStop}" Click="OnStopClick" />
          </StackPanel>
        </Grid>

        <!-- Banner de elevação (porta do AdminWarning do WPF; tints quentes da pílula) -->
        <Border IsVisible="{Binding IsAdminBannerVisible}" Background="{DynamicResource BgTintWarmBrush}" BorderBrush="{DynamicResource BorderTintWarmBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Privilégios administrativos necessários" Foreground="{DynamicResource AccentWarningBrush}" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Text="Algumas leituras de CPU e FPS podem exigir privilégios de administrador." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Classes="action accent" Content="Executar como admin" Click="OnRestartAsAdminClick" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
          <Border Classes="desktop-card">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="PROCESSADOR" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
                <Border Grid.Column="1" Background="{DynamicResource BgChipBrush}" CornerRadius="8" Padding="8,3">
                  <TextBlock Text="CPU" Foreground="{DynamicResource AccentChipCpuBrush}" FontSize="11" FontWeight="Bold" />
                </Border>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="{Binding CpuUsageText}" Classes="metric" Foreground="{Binding CpuUsageBrush}" />
                  <TextBlock Text="Utilização total" Classes="muted" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="5">
                  <Border Background="{Binding CpuTempPillBrush}" BorderBrush="{Binding CpuTempPillBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,3" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding CpuTempText}" Foreground="{Binding CpuTempBrush}" FontSize="12" FontWeight="SemiBold" />
                  </Border>
                  <TextBlock Text="{Binding CpuClockText}" Classes="muted" FontSize="11" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
              <charts:HistoryChart Grid.Row="2" Values="{Binding CpuSamples}" Stroke="{DynamicResource AccentLightBrush}" Height="52" />
              <TextBlock Grid.Row="3" Text="{Binding CpuDetailText}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="monospace" FontSize="11" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>

          <Border Grid.Column="1" Classes="desktop-card">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="PLACA DE VÍDEO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
                <Border Grid.Column="1" Background="{DynamicResource BgChipBrush}" CornerRadius="8" Padding="8,3">
                  <TextBlock Text="GPU" Foreground="{DynamicResource AccentPurpleChipBrush}" FontSize="11" FontWeight="Bold" />
                </Border>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="{Binding GpuUsageText}" Classes="metric" Foreground="{Binding GpuUsageBrush}" />
                  <TextBlock Text="Utilização do núcleo" Classes="muted" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="5">
                  <Border Background="{Binding GpuTempPillBrush}" BorderBrush="{Binding GpuTempPillBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,3" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding GpuTempText}" Foreground="{Binding GpuTempBrush}" FontSize="12" FontWeight="SemiBold" />
                  </Border>
                  <TextBlock Text="{Binding GpuMemoryText}" Classes="muted" FontSize="11" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
              <charts:HistoryChart Grid.Row="2" Values="{Binding GpuSamples}" Stroke="{DynamicResource AccentPurpleSoftBrush}" Height="52" />
              <TextBlock Grid.Row="3" Text="{Binding GpuDetailText}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="monospace" FontSize="11" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="OverviewSecondaryCards" ColumnDefinitions="*,*,*,*" ColumnSpacing="14" RowSpacing="14">
          <Border Classes="desktop-card" Padding="17">
            <StackPanel Spacing="11">
              <TextBlock Text="MEMÓRIA RAM" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
              <TextBlock Text="{Binding RamUsageText}" Classes="metric" />
              <TextBlock Text="{Binding RamDetailText}" Classes="muted" FontSize="11" />
              <charts:HistoryChart Values="{Binding RamSamples}" Stroke="{DynamicResource AccentGreenBrush}" Height="34" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="desktop-card" Padding="17">
            <StackPanel Spacing="12">
              <TextBlock Text="DISCO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
              <StackPanel Spacing="4">
                <TextBlock Text="LEITURA" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding DiskReadText}" Foreground="{DynamicResource TextBodyBrush}" FontSize="16" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="GRAVAÇÃO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding DiskWriteText}" Foreground="{DynamicResource TextBodyBrush}" FontSize="16" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="desktop-card" Padding="17">
            <StackPanel Spacing="12">
              <TextBlock Text="REDE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
              <StackPanel Spacing="4">
                <TextBlock Text="DOWNLOAD" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding NetworkDownText}" Foreground="{DynamicResource TextBodyBrush}" FontSize="16" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="UPLOAD" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding NetworkUpText}" Foreground="{DynamicResource TextBodyBrush}" FontSize="16" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Classes="desktop-card" Padding="17">
            <StackPanel Spacing="11">
              <TextBlock Text="PLACA-MÃE &amp; VENTOINHAS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
              <TextBlock Text="{Binding MotherboardTempText}" Foreground="{Binding MbTempBrush}" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Text="{Binding FanSummaryText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="desktop-card">
          <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="FPS EM JOGO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding FpsHint}" Classes="muted" FontSize="11" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="22" VerticalAlignment="Center">
                <StackPanel>
                  <TextBlock Text="FPS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
                  <TextBlock Text="{Binding FpsText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="25" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="FRAMETIME" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
                  <TextBlock Text="{Binding FrametimeText}" Foreground="{DynamicResource TextBodyBrush}" FontSize="16" />
                </StackPanel>
              </StackPanel>
            </Grid>
            <charts:HistoryChart Grid.Row="1" IsVisible="{Binding HasFpsData}" Values="{Binding FrametimeSamples}" Stroke="{DynamicResource AccentWarningBrush}" Height="56" />
            <TextBlock Grid.Row="2" IsVisible="{Binding HasFpsData}" Text="{Binding FpsStatsText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
          </Grid>
        </Border>

        <!-- Porta do card de processos na GPU do WPF (nome + uso % à direita) -->
        <Border Classes="desktop-card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="PROCESSOS ATIVOS NA GPU" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
              <TextBlock Grid.Column="1" Text="Relatado pelo Windows via WMI (GPUEngine)" Classes="muted" FontSize="11" />
            </Grid>
            <ItemsControl ItemsSource="{Binding GpuProcessRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,5">
                    <Grid ColumnDefinitions="*,80">
                      <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBodyBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Usage, StringFormat={}{0:F1}%}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock IsVisible="{Binding !HasGpuProcesses}" Text="Sem atividade de GPU relevante agora." Classes="muted" FontSize="11" />
          </StackPanel>
        </Border>

        <TextBlock Text="Os valores de temperatura, clock e utilização dependem dos sensores expostos pelo kernel e pelo driver." Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,0" />
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsInventory}">
      <StackPanel Margin="28,23,28,28" Spacing="16">
        <Grid RowDefinitions="Auto,Auto" Margin="0,0,0,3" RowSpacing="10">
          <StackPanel Spacing="4">
            <TextBlock Text="Inventário de sensores" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding InventorySummaryText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="{Binding InventoryUpdatedText}" Classes="muted" FontSize="11" />
            <TextBlock IsVisible="{Binding HasInventoryActionStatus}" Text="{Binding InventoryActionStatusText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
          <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Classes="action" Content="Iniciar" IsEnabled="{Binding CanStart}" Click="OnStartClick" Margin="0,0,8,8" />
            <Button Classes="action" Content="{Binding PauseButtonText}" IsEnabled="{Binding CanPause}" Click="OnPauseClick" Margin="0,0,8,8" />
            <Button Classes="action" Content="Parar" IsEnabled="{Binding CanStop}" Click="OnStopClick" Margin="0,0,8,8" />
            <Button Classes="action" Content="Resetar estatísticas" Click="OnResetStatsClick"
                    Margin="0,0,8,8"
                    ToolTip.Tip="Zera as colunas Mín/Máx/Média da sessão e grava um marcador no CSV/journal ativo (#marker), como no WPF." />
          </WrapPanel>
        </Grid>

        <Border IsVisible="{Binding IsWaitingForInventorySnapshot}" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
          <TextBlock Text="Aguardando a primeira leitura dos sensores…" Classes="muted" FontSize="12" />
        </Border>

        <ScrollViewer IsVisible="{Binding HasInventorySnapshot}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Border MinWidth="640" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Stretch">
          <StackPanel Spacing="0" HorizontalAlignment="Stretch">
            <Border Background="{DynamicResource BgChipBrush}" BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="0,0,0,1" Padding="10,6" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="*,96,96,96,96" ColumnSpacing="8" HorizontalAlignment="Stretch">
                <TextBlock Text="Sensor" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,0,0" />
                <Border Grid.Column="1" Background="{DynamicResource InventoryValueCellBrush}" BorderBrush="{DynamicResource InventoryValueCellBorderBrush}" BorderThickness="1,0" Padding="5,2">
                  <TextBlock Text="Atual" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" TextAlignment="Right" />
                </Border>
                <TextBlock Grid.Column="2" Text="Mínimo" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="Máximo" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="Média" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding InventoryGroups}" HorizontalAlignment="Stretch">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <ToggleButton Classes="inventory-group" Content="{Binding Title}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Title}" />
                        <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding IsExpanded}" HorizontalAlignment="Stretch">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="0,1,0,0" Padding="10,2" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="0" HorizontalAlignment="Stretch">
                                  <Grid ColumnDefinitions="*,96,96,96,96" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="20,*">
                                      <TextBlock Text="{Binding SensorName}"
                                                 Grid.Column="1" FontWeight="SemiBold"
                                                 ToolTip.Tip="{Binding SensorNameTooltip}"
                                                 ToolTip.ShowDelay="2000"
                                                 Foreground="{DynamicResource TextBodyBrush}"
                                                 FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                      <Button Classes="inventory-row-toggle" Content="{Binding ExpansionGlyph}"
                                              IsVisible="{Binding CanCollapseChildren}"
                                              Click="OnInventoryRowToggleClick"
                                              Width="20" Height="22" Foreground="{DynamicResource TextBodyBrush}"
                                              FontSize="12" FontWeight="SemiBold"
                                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              ToolTip.Tip="Expandir ou recolher sensores" AutomationProperties.Name="{Binding SensorName}" />
                                    </Grid>
                                  <Border Grid.Column="1" Background="{DynamicResource InventoryValueCellBrush}" BorderBrush="{DynamicResource InventoryValueCellBorderBrush}" BorderThickness="1,0" Padding="5,3">
                                    <TextBlock Text="{Binding Current}" ToolTip.Tip="{Binding Current}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="monospace" FontSize="12" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                  </Border>
                                  <TextBlock Grid.Column="2" Text="{Binding Min}" ToolTip.Tip="{Binding Min}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="monospace" FontSize="12" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="3" Text="{Binding Max}" ToolTip.Tip="{Binding Max}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="monospace" FontSize="12" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="4" Text="{Binding Avg}" ToolTip.Tip="{Binding Avg}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="monospace" FontSize="12" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                  </Grid>
                                  <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding ShowChildren}" HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <Grid ColumnDefinitions="*,96,96,96,96" ColumnSpacing="8" HorizontalAlignment="Stretch" Margin="0,1,0,0">
                                          <TextBlock Text="{Binding SensorName}" ToolTip.Tip="{Binding SensorName}" Foreground="{DynamicResource TextBodyBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="38,0,0,0" />
                                          <Border Grid.Column="1" Background="{DynamicResource InventoryValueCellBrush}" BorderBrush="{DynamicResource InventoryValueCellBorderBrush}" BorderThickness="1,0" Padding="5,3">
                                            <TextBlock Text="{Binding Current}" ToolTip.Tip="{Binding Current}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="monospace" FontSize="12" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                          </Border>
                                          <TextBlock Grid.Column="2" Text="{Binding Min}" ToolTip.Tip="{Binding Min}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="monospace" FontSize="12" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                          <TextBlock Grid.Column="3" Text="{Binding Max}" ToolTip.Tip="{Binding Max}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="monospace" FontSize="12" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                          <TextBlock Grid.Column="4" Text="{Binding Avg}" ToolTip.Tip="{Binding Avg}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="monospace" FontSize="12" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        </ScrollViewer>

        <Button Content="Hardware detectado…" HorizontalAlignment="Left" Margin="0,0,0,14"
                IsVisible="{Binding HasInventorySnapshot}" Click="OnOpenHardwareInventoryClick" />

        <Border Classes="desktop-card" Padding="16" Margin="0,0,0,14" IsVisible="{Binding HasMonitors}">
          <StackPanel Spacing="10">
            <TextBlock Text="Monitores (EDID)" Foreground="{DynamicResource TextBodyBrush}" FontSize="14" FontWeight="SemiBold" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Monitors}" MinWidth="620">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                    <StackPanel Spacing="3">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding InstanceName}" Foreground="{DynamicResource TextMonoBrush}" FontFamily="monospace" FontSize="11" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="PRIMÁRIO" IsVisible="{Binding Primary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Manufacturer}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" MinWidth="48" />
                        <TextBlock Text="{Binding Model}" Foreground="{DynamicResource TextBodyBrush}" FontSize="11" MinWidth="120" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ProductCode}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" MinWidth="64" />
                        <TextBlock Text="{Binding Serial}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" MinWidth="96" />
                        <TextBlock Text="{Binding DiagonalText}" Foreground="{DynamicResource TextBodyBrush}" FontSize="11" MinWidth="56" />
                        <TextBlock Text="{Binding MadeText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <TextBlock Text="Os sensores indisponíveis dependem do hardware, dos drivers e dos dados expostos pelo kernel." Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,0" />
      </StackPanel>
    </ScrollViewer>

    <pages:SettingsPage OpenOverlayEditorRequested="OnOpenOverlayEditorRequested"
                        OpenThemePaletteEditorRequested="OnOpenThemePaletteEditorRequested" Grid.Column="1" />

    <pages:CustomSensorsPage Grid.Column="1" />

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsSensorTuning}">
      <StackPanel Margin="28,23,28,28" Spacing="16">
        <Grid RowDefinitions="Auto,Auto" Margin="0,0,0,3" RowSpacing="10">
          <StackPanel Spacing="4">
            <TextBlock Text="Ajuste por série" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Configure a cadência de publicação e a suavização das leituras." Classes="muted" FontSize="11" />
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="action" Content="Iniciar" IsEnabled="{Binding CanStart}" Click="OnStartClick" />
            <Button Classes="action" Content="{Binding PauseButtonText}" IsEnabled="{Binding CanPause}" Click="OnPauseClick" />
            <Button Classes="action" Content="Parar" IsEnabled="{Binding CanStop}" Click="OnStopClick" />
          </StackPanel>
        </Grid>

        <Border Classes="desktop-card" Padding="16">
          <StackPanel Spacing="7">
            <TextBlock Text="COMO AS REGRAS SE APLICAM" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="Intervalo 0 usa cada tick global; valores positivos são limitados a 100–3.600.000 ms e elevados ao intervalo global quando necessário. Suavização 0 ou 1 desliga o filtro; 2–60 usa uma média móvel das amostras frescas." Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="Padrões podem sobrepor várias séries. A última regra correspondente na lista prevalece; use as setas para mudar a ordem. Série ausente fica preservada e será ajustada quando aparecer." Foreground="{DynamicResource AccentWarningBrush}" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="Salvar recria a sessão de sensores e zera as estatísticas. Coleta parada permanece parada; coleta pausada continua pausada." Classes="muted" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="REGRAS DE AJUSTE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="Até 64 regras. Selecione uma série detectada/salva ou digite uma série/padrão." Classes="muted" FontSize="11" />
          </StackPanel>
          <Button Grid.Column="1" Classes="action accent" Content="Adicionar regra" Click="OnAddSensorTuningClick" />
        </Grid>

        <ItemsControl ItemsSource="{Binding SensorTuningEditors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="desktop-card" Padding="16" Margin="0,0,0,12">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding SeriesLabel}" Foreground="{DynamicResource AccentChipCpuBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="↑" IsEnabled="{Binding CanMoveUp}" Click="OnMoveSensorTuningUpClick" />
                    <Button Grid.Column="2" Content="↓" IsEnabled="{Binding CanMoveDown}" Click="OnMoveSensorTuningDownClick" />
                    <Button Grid.Column="3" Content="Remover" Click="OnRemoveSensorTuningClick" />
                  </Grid>
                  <Grid ColumnDefinitions="1.3*,*" ColumnSpacing="10">
                    <StackPanel Spacing="5">
                      <TextBlock Text="SÉRIE OU PADRÃO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
                      <TextBox Text="{Binding Series, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="GpuTemperature ou Gpu*" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5">
                      <TextBlock Text="SUGESTÕES DO INVENTÁRIO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
                      <ComboBox ItemsSource="{Binding SeriesOptions}" SelectedItem="{Binding SelectedSeriesOption, Mode=TwoWay}" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="5">
                      <TextBlock Text="INTERVALO (MS)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
                      <TextBox Text="{Binding IntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0 = global" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5">
                      <TextBlock Text="SUAVIZAÇÃO (AMOSTRAS)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
                      <TextBox Text="{Binding SmoothingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0 = desativada" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
          <Button Classes="action accent" Content="Salvar e aplicar" Click="OnSaveSensorTuningsClick" />
          <TextBlock Grid.Column="1" Text="{Binding SensorTuningMessage}" Classes="muted" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <pages:AlertsPage Grid.Column="1" />

    <pages:DiagnosticsPage x:Name="DiagnosticsPageControl" Grid.Column="1" />

    <!-- Toast de alerta (paridade estrutural do AlertPopupWindow do WPF; cores via tokens AlertToast*). -->
    <Border Grid.Column="1" ZIndex="10" IsVisible="{Binding AlertToastVisible}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,18,0" MaxWidth="420" Background="{DynamicResource AlertToastBackgroundBrush}" BorderBrush="{DynamicResource AlertToastBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
      <StackPanel Spacing="5">
        <TextBlock Text="PHANTOM MONITOR · ALERTA" Foreground="{DynamicResource AlertToastHeaderBrush}" FontSize="11" FontWeight="Bold" />
        <TextBlock Text="{Binding AlertToastMessage}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Update update: same pattern as the alerts toast, in the top-right corner of the dashboard. -->
    <Border Grid.Column="1" ZIndex="10" IsVisible="{Binding UpdateToastVisible}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,18,0" MaxWidth="440" Background="{DynamicResource BgToastUpdateBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
      <StackPanel Spacing="8">
        <TextBlock Text="PHANTOM MONITOR · ATUALIZAÇÃO" Foreground="{DynamicResource AccentGreenSoftBrush}" FontSize="11" FontWeight="Bold" />
        <TextBlock Text="{Binding UpdateToastText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Abrir GitHub" Click="OnOpenReleasesPageClick" />
          <Button Content="{Binding UpdateButtonText}" Click="OnApplyUpdateClick"
                  IsVisible="{Binding CanApplyUpdate}" IsEnabled="{Binding CanApplyUpdateEnabled}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
