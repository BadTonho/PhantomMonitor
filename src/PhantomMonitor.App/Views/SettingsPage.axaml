<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            x:Class="PhantomMonitor.App.Views.SettingsPage"
            xmlns:vmroot="using:PhantomMonitor.App.ViewModels"
            xmlns:svc="using:PhantomMonitor.Services"
            x:DataType="vmroot:MainWindowViewModel">
  <UserControl.Styles>
    <Style Selector="Border.desktop-card">
      <Setter Property="Padding" Value="14,11" />
    </Style>
    <Style Selector="Button.settings-help-icon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.settings-help-icon:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.keycap">
      <Setter Property="Background" Value="{DynamicResource BgWindowBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="MinWidth" Value="54" />
      <Setter Property="FontFamily" Value="monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.keycap:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentChipCpuBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
    </Style>
    <Style Selector="CheckBox.settings-check">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
      <Setter Property="Padding" Value="8,0,0,0" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="CheckBox.settings-check:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsSettings}">
    <StackPanel Margin="24,16,24,22" Spacing="10">
      <Border IsVisible="{Binding HasConfigurationWarning}" Background="{DynamicResource BgTintWarmBrush}"
              BorderBrush="{DynamicResource BorderTintWarmBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
        <TextBlock Text="{Binding ConfigurationWarning}" Foreground="{DynamicResource AccentWarningBrush}" TextWrapping="Wrap" />
      </Border>

      <StackPanel Spacing="2" Margin="0,0,0,2">
        <TextBlock Text="Configurações" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Ajuste a coleta, o overlay e os arquivos de telemetria." Classes="muted" FontSize="11" />
      </StackPanel>

      <!-- Linha 1: Coleta + Inicialização -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
        <Border Grid.Column="0" Classes="desktop-card">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="COLETA" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="settings-help-icon" AutomationProperties.Name="Ajuda da seção COLETA">
                <ToolTip.Tip>
                  <TextBlock Text="Define o intervalo de coleta, de 100 a 60.000 ms. Intervalos menores atualizam o painel com mais frequência."
                             MaxWidth="420" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                </ToolTip.Tip>
                <Grid Width="15" Height="15">
                  <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                  <TextBlock Text="i" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Margin="0,-1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Grid>
              </Button>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="Intervalo global (ms)" Foreground="{DynamicResource TextBodyBrush}" FontSize="12" VerticalAlignment="Center" />
              <TextBox Classes="settings-input" Width="120" Padding="10,5" Text="{Binding UpdateIntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <TextBlock IsVisible="{Binding IsLegacyIntervalOutOfRange}" Text="O config atual usa mais de 60.000 ms. Esse valor será mantido até você editar o intervalo." Foreground="{DynamicResource AccentWarningBrush}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="desktop-card" IsVisible="{Binding StartupSupported}">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="INICIALIZAÇÃO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="settings-help-icon" AutomationProperties.Name="Ajuda da seção INICIALIZAÇÃO">
                <ToolTip.Tip>
                  <TextBlock Text="Ativa ou desativa a inicialização automática do PhantomMonitor ao entrar no sistema. A mudança é aplicada imediatamente."
                             MaxWidth="420" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                </ToolTip.Tip>
                <Grid Width="15" Height="15">
                  <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                  <TextBlock Text="i" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Margin="0,-1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Grid>
              </Button>
            </Grid>
            <CheckBox Classes="settings-check" Content="Iniciar com o sistema" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Linha 2: Modo do Overlay -->
      <Border Classes="desktop-card">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="MODO DO OVERLAY" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="settings-help-icon" AutomationProperties.Name="Ajuda da seção MODO DO OVERLAY">
              <ToolTip.Tip>
                <StackPanel MaxWidth="420" Spacing="6">
                  <TextBlock Text="Janela flutuante mantém os blocos em janelas separadas. Dentro do jogo usa um renderer nativo e depende do suporte da API gráfica; anti-cheats podem bloqueá-lo. O atalho alterna o overlay e o editor ajusta os blocos."
                             TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="No Windows, o app detecta globalmente aplicações apresentando frames enquanto está aberto e tenta instalar o hook sem cadastro de executável, usando ETW/PresentMon. Pode exigir a conta no grupo Performance Log Users. Aplicações Vulkan já abertas precisam ser reiniciadas; jogos elevados podem ignorar registros por usuário. Anti-cheats podem recusar o hook. Para jogos D3D12 sem overlay, adicione o executável abaixo e use Iniciar."
                             TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="Se não houver desenho, confirme que Mostrar overlay está ativo. O diagnóstico informa se os hooks nativos x86/x64 estão presentes; um dotnet build/publish comum não os compila."
                             TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="No Linux, os pacotes incluem a camada Vulkan e o preload OpenGL GLX/EGL. Ao ativar Dentro do jogo, o app registra a camada e publica ENABLE_PHANTOM_OVERLAY e LD_PRELOAD no ambiente D-Bus/systemd da sessão e nas sessões futuras. No KDE Plasma, tenta atualizar o ambiente de lançamento pelo serviço de sessão; em sessões KDE 5, também tenta o KLauncher. Se o diagnóstico não confirmar, jogos iniciados pelo desktop talvez não recebam o hook nesta sessão. Feche e reabra jogos ou launchers já abertos depois da confirmação. Flatpak pode exigir integração própria."
                             TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
              </ToolTip.Tip>
              <Grid Width="15" Height="15">
                <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                <TextBlock Text="i" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,-1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Grid>
            </Button>
          </Grid>

          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
            <StackPanel Spacing="5">
              <TextBlock Text="RENDERIZAÇÃO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
              <ListBox Classes="segmented-pills"
                       ItemsSource="{Binding OverlayRenderModeOptions}"
                       SelectedIndex="{Binding OverlayRenderModeIndex, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Text="ATALHO GLOBAL DO OVERLAY" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="OverlayHotkeyButton" Classes="keycap" Content="{Binding OverlayHotkeyButtonText}" Click="OnCaptureOverlayHotkeyClick" IsEnabled="{Binding !IsSavingSettings}" />
                <Button Classes="secondary" Content="Limpar atalho" Click="OnClearOverlayHotkeyClick" IsEnabled="{Binding !IsSavingSettings}" />
                <TextBlock Text="{Binding OverlayHotkeyStatus}" Classes="muted" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>

            <Button Grid.Column="2" Classes="action accent" Content="Abrir editor do overlay" Click="OnOpenOverlayEditorClick" VerticalAlignment="Bottom" />
          </Grid>

          <TextBlock IsVisible="{Binding IsOverlayInGameModeSelected}" Text="{Binding InGameOverlayCapabilityNotice}" Foreground="{DynamicResource AccentWarningBrush}" FontSize="11" TextWrapping="Wrap" />

          <StackPanel IsVisible="{Binding IsOverlayInGameModeSelected}" Spacing="6">
            <Border Background="{DynamicResource BgWindowBrush}" BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
              <StackPanel Spacing="3">
                <TextBlock Text="DIAGNÓSTICO DO OVERLAY" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                <TextBlock Text="{Binding InGameOverlayDiagnosticText}" Foreground="{DynamicResource TextBodyBrush}" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <StackPanel IsVisible="{Binding IsWindowsPlatform}" Spacing="6">
              <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding OverlayTargetPathText, Mode=TwoWay}" PlaceholderText="Caminho do executável" />
                <TextBox Grid.Column="1" Text="{Binding OverlayTargetArgumentsText, Mode=TwoWay}" PlaceholderText="Argumentos (opcional)" />
                <Button Grid.Column="2" Classes="secondary" Content="Adicionar" Click="OnAddOverlayTargetClick" />
              </Grid>
              <ItemsControl ItemsSource="{Binding OverlayInGameTargets}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="svc:OverlayLaunchTargetConfig">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                      <TextBlock Text="{Binding ExecutablePath}" Foreground="{DynamicResource TextBodyBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="1" Classes="secondary" IsVisible="{Binding $parent[UserControl].((vmroot:MainWindowViewModel)DataContext).IsOverlayTargetLaunchVisible}" Content="Iniciar" Click="OnLaunchOverlayTargetClick" />
                      <Button Grid.Column="2" Classes="secondary" Content="Remover" Click="OnRemoveOverlayTargetClick" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding OverlayTargetMessage}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>

          <Border IsVisible="{Binding IsLinuxOverlaySessionWarningVisible}"
                  Background="{DynamicResource BgWindowBrush}"
                  BorderBrush="{DynamicResource BgCardBorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="10,8">
            <StackPanel Spacing="3">
              <TextBlock Text="INTEGRAÇÃO DA SESSÃO LINUX" Foreground="{DynamicResource AccentWarningBrush}" FontSize="10" FontWeight="Bold" />
              <TextBlock Text="{Binding LinuxOverlaySessionDiagnosticText}" Foreground="{DynamicResource TextBodyBrush}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Linha 3: Interface -->
      <Border Classes="desktop-card">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="INTERFACE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="settings-help-icon" AutomationProperties.Name="Ajuda da seção INTERFACE">
              <ToolTip.Tip>
                <TextBlock Text="Neptune usa o visual original do Avalonia; Slate reproduz o visual do WPF. Escolha um tema e personalize as cores; as mudanças são aplicadas em ‘Salvar e aplicar’, sem reiniciar. Posição e exibição da navegação são salvas imediatamente. O dock fica dentro da janela, centralizado no rodapé, sem arraste."
                           MaxWidth="420" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
              </ToolTip.Tip>
              <Grid Width="15" Height="15">
                <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                <TextBlock Text="i" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,-1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Grid>
            </Button>
          </Grid>

          <WrapPanel>
            <StackPanel Spacing="5" Margin="0,0,18,4">
              <TextBlock Text="TEMA VISUAL" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" ItemsSource="{Binding ThemeOptions}" MinWidth="220" HorizontalAlignment="Left" />
                <Button Classes="secondary" Content="Personalizar paleta" Click="OnOpenThemePaletteEditorClick" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="5" Margin="0,0,18,4">
              <TextBlock Text="POSIÇÃO DA NAVEGAÇÃO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
              <ListBox Classes="segmented-pills"
                       SelectedIndex="{Binding NavigationPositionIndex, Mode=TwoWay}"
                       ItemsSource="{Binding NavigationPositionOptions}" />
            </StackPanel>

            <StackPanel Spacing="5" Margin="0,0,0,4">
              <TextBlock Text="EXIBIÇÃO DA NAVEGAÇÃO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
              <ListBox Classes="segmented-pills"
                       SelectedIndex="{Binding NavigationDisplayModeIndex, Mode=TwoWay}"
                       ItemsSource="{Binding NavigationDisplayModeOptions}" />
            </StackPanel>
          </WrapPanel>

          <TextBlock Text="{Binding NavigationSettingsMessage}" IsVisible="{Binding HasNavigationSettingsMessage}"
                     Classes="muted" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Linha 4: Beta + Gravação de Telemetria -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
        <Border Grid.Column="0" Classes="desktop-card">
          <StackPanel Spacing="5">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="BETA" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="settings-help-icon" AutomationProperties.Name="Ajuda da seção BETA">
                <ToolTip.Tip>
                  <TextBlock Text="Controla a exibição na navegação de Sensores customizados, Ajuste por série e Alertas. Cada escolha é salva imediatamente."
                             MaxWidth="420" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                </ToolTip.Tip>
                <Grid Width="15" Height="15">
                  <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                  <TextBlock Text="i" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Margin="0,-1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Grid>
              </Button>
            </Grid>
            <CheckBox Classes="settings-check" Content="Mostrar Sensores customizados na navegação"
                      IsChecked="{Binding ShowCustomSensorsInSidebar, Mode=TwoWay}" />
            <CheckBox Classes="settings-check" Content="Mostrar Ajuste por série na navegação"
                      IsChecked="{Binding ShowSensorTuningInSidebar, Mode=TwoWay}" />
            <CheckBox Classes="settings-check" Content="Mostrar Alertas na navegação"
                      IsChecked="{Binding ShowAlertsInSidebar, Mode=TwoWay}" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="desktop-card">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="GRAVAÇÃO DE TELEMETRIA" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="settings-help-icon" AutomationProperties.Name="Ajuda da seção GRAVAÇÃO DE TELEMETRIA">
                <ToolTip.Tip>
                  <TextBlock Text="Escolha os formatos de telemetria que serão gravados. A pasta dos arquivos aparece no card."
                             MaxWidth="420" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                </ToolTip.Tip>
                <Grid Width="15" Height="15">
                  <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                  <TextBlock Text="i" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Margin="0,-1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Grid>
              </Button>
            </Grid>
            <WrapPanel>
              <CheckBox Classes="settings-check" Content="Exportar CSV" IsChecked="{Binding LogToCsv, Mode=TwoWay}" Margin="0,0,14,0" />
              <CheckBox Classes="settings-check" Content="Snapshot JSON" IsChecked="{Binding LogToJson, Mode=TwoWay}" Margin="0,0,14,0" />
              <CheckBox Classes="settings-check" Content="Journal JSONL" IsChecked="{Binding LogToJsonJournal, Mode=TwoWay}" />
            </WrapPanel>
            <StackPanel Spacing="2" Margin="0,2,0,0">
              <TextBlock Text="PASTA DOS ARQUIVOS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
              <TextBlock Text="{Binding LogDirectoryText}" Foreground="{DynamicResource TextMonoBrush}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Linha 5: Exportador HTTP + Atualizações -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
        <Border Grid.Column="0" Classes="desktop-card">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="EXPORTADOR HTTP" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="settings-help-icon" AutomationProperties.Name="Ajuda da seção EXPORTADOR HTTP">
                <ToolTip.Tip>
                  <TextBlock Text="GET /values retorna o snapshot JSON e GET /health verifica o listener. O serviço funciona durante a coleta e mantém o último snapshot durante a pausa."
                             MaxWidth="420" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                </ToolTip.Tip>
                <Grid Width="15" Height="15">
                  <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                  <TextBlock Text="i" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Margin="0,-1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Grid>
              </Button>
            </Grid>
            <WrapPanel>
              <CheckBox Classes="settings-check" Content="Ativar endpoints" IsChecked="{Binding TelemetryExportEnabled, Mode=TwoWay}" Margin="0,0,14,0" />
              <CheckBox Classes="settings-check" Content="Escutar na LAN" IsChecked="{Binding TelemetryExportListenAll, Mode=TwoWay}" />
            </WrapPanel>
            <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
              <StackPanel Spacing="3">
                <TextBlock Text="PORTA (1024–65535)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                <TextBox Text="{Binding TelemetryExportPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="7317" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="ENDPOINTS / ESTADO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                <TextBlock Text="{Binding TelemetryExportEndpointText}" Foreground="{DynamicResource TextMonoBrush}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding TelemetryExportStatusText}" Foreground="{DynamicResource TextMonoBrush}" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
            <TextBlock Text="A opção LAN permite acesso por outros dispositivos da rede. Ative somente em uma rede confiável." Foreground="{DynamicResource AccentWarningBrush}" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="desktop-card">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="ATUALIZAÇÕES (GITHUB RELEASES)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="settings-help-icon" AutomationProperties.Name="Ajuda da seção ATUALIZAÇÕES">
                <ToolTip.Tip>
                  <TextBlock Text="Configura a checagem automática, o canal de pré-lançamentos e o repositório. A atualização baixa a nova versão, reabre o app e preserva configurações e logs; instalações por pacote do sistema não oferecem essa troca."
                             MaxWidth="420" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                </ToolTip.Tip>
                <Grid Width="15" Height="15">
                  <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                  <TextBlock Text="i" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Margin="0,-1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Grid>
              </Button>
            </Grid>
            <WrapPanel>
              <CheckBox Classes="settings-check" Content="Verificar automaticamente (24h)" IsChecked="{Binding UpdateAutoCheck, Mode=TwoWay}" Margin="0,0,14,0" />
              <CheckBox Classes="settings-check" Content="Canal beta" IsChecked="{Binding UpdateBetaChannel, Mode=TwoWay}" />
            </WrapPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <StackPanel Spacing="3">
                <TextBlock Text="REPOSITÓRIO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                <TextBox Text="{Binding UpdateRepositoryText, Mode=TwoWay}" PlaceholderText="BadTonho/PhantomMonitor" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="ESTADO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                <TextBlock Text="{Binding UpdateVersionText}" Foreground="{DynamicResource TextMonoBrush}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding UpdateStatusText}" Foreground="{DynamicResource TextMonoBrush}" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
              <Button Classes="action accent" Padding="10,6" Content="Buscar agora" Click="OnCheckUpdatesClick" />
              <Button Classes="secondary" Content="Abrir releases" Click="OnOpenReleasesPageClick" />
              <Button Classes="secondary" Content="{Binding UpdateButtonText}" Click="OnApplyUpdateClick"
                      IsVisible="{Binding CanApplyUpdate}" IsEnabled="{Binding CanApplyUpdateEnabled}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <TextBlock Text="{Binding SettingsMessage}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
      <Border Height="88" IsVisible="{Binding IsDockNavigation}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
