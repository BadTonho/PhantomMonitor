<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PhantomMonitor.App</RootNamespace>
    <AssemblyName>PhantomMonitor.App</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- Marcador de build de desenvolvimento: o updater nunca "atualiza" um 0.0.0-dev.
         A release passa /p:Version=<tag> no publish e a versão compilada passa a casar. -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhantomMonitor.Core\PhantomMonitor.Core.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
    <PackageReference Include="Tmds.DBus.Generator" Version="0.95.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- PresentMon acompanha o binário Windows: coleta de FPS passa a existir no app único.
         No Linux o arquivo não existe e a condição evita erro de glob. -->
    <None Include="..\..\tools\PresentMon.exe" Condition="Exists('..\..\tools\PresentMon.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="DBus\org.freedesktop.Notifications.xml"
                     Namespace="PhantomMonitor.App.Linux.DBus"
                     DBusGeneratorMode="Proxy" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\config.example.json" Link="config.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
