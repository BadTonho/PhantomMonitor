<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:PhantomMonitor.App.Views"
        x:Class="PhantomMonitor.App.Views.OverlayBlockWindow"
        Title="Phantom Monitor Overlay"
        Width="{Binding PresentationWidth}" SizeToContent="Height"
        CanResize="False" WindowDecorations="None" WindowStartupLocation="Manual"
        ShowInTaskbar="False" Topmost="True"
        TransparencyLevelHint="Transparent" Background="Transparent">
  <views:OverlayBlockContentView />
</Window>
