<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhantomMonitor.App.ViewModels"
        x:Class="PhantomMonitor.App.Views.OverlayBlockContentPickerDialog"
        Title="Adicionar conteúdo ao bloco"
        Width="700" Height="760" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}">
  <Window.Styles>
    <StyleInclude Source="avares://PhantomMonitor/Themes/DesktopStyles.axaml" />
  </Window.Styles>
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="18" Spacing="12">
        <TextBlock Text="ADICIONAR CONTEÚDO" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Text="Os itens confirmados entram no final da lista do bloco. Você pode reorganizar a ordem depois."
                   FontSize="11" TextWrapping="Wrap" Classes="muted" />
        <Button Content="Adicionar linha personalizada" HorizontalAlignment="Left" Click="OnAddCustomLineClick" />
        <ItemsControl ItemsSource="{Binding CategoriesChoices}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:OverlayBlockContentChoiceViewModel}">
              <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,18,6" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <CheckBox Content="{Binding FrametimeChoice.Label}" IsChecked="{Binding FrametimeChoice.IsSelected}" />

        <TextBlock Text="SÉRIES" FontSize="10" FontWeight="Bold" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <ComboBox ItemsSource="{Binding SeriesCategories}"
                    SelectedItem="{Binding SelectedSeriesCategory, Mode=TwoWay}"
                    MinWidth="180" HorizontalAlignment="Stretch" />
          <CheckBox Grid.Column="1" Content="Selecionar todas as séries exibidas"
                    IsThreeState="True"
                    IsChecked="{Binding SeriesCategorySelectionState, Mode=OneWay}"
                    Click="OnToggleSeriesCategoryClick"
                    VerticalAlignment="Center" />
        </Grid>
        <ItemsControl ItemsSource="{Binding SeriesChoices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:OverlayBlockContentChoiceViewModel}">
              <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Nenhuma série encontrada nesta categoria."
                   Classes="muted"
                   IsVisible="{Binding NoSeriesChoices}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox PlaceholderText="Série ou padrão (ex.: Gpu* ou DiskRead#1)" Text="{Binding SeriesPatternInput, UpdateSourceTrigger=PropertyChanged}" />
          <Button Grid.Column="1" Content="Adicionar padrão" Click="OnAddSeriesPatternClick" />
        </Grid>

        <TextBlock Text="GRÁFICOS" FontSize="10" FontWeight="Bold" />
        <ItemsControl ItemsSource="{Binding GraphChoices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:OverlayBlockContentChoiceViewModel}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                <Button Grid.Column="1" Content="Editar" Padding="10,4" Click="OnEditGraphClick" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox PlaceholderText="Série (ex.: GpuTemperature#1)" Text="{Binding GraphSeries, UpdateSourceTrigger=PropertyChanged}" />
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
          <StackPanel Spacing="3"><TextBlock Text="ALTURA" FontSize="9" /><TextBox Text="{Binding GraphHeight, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
          <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="AMOSTRAS" FontSize="9" /><TextBox Text="{Binding GraphWindow, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
          <StackPanel Grid.Column="2" Spacing="3"><TextBlock Text="MÍN." FontSize="9" /><TextBox PlaceholderText="Auto" Text="{Binding GraphMin, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
          <StackPanel Grid.Column="3" Spacing="3"><TextBlock Text="MÁX." FontSize="9" /><TextBox PlaceholderText="Auto" Text="{Binding GraphMax, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
        </Grid>
        <TextBox PlaceholderText="Cor opcional #RRGGBB" Text="{Binding GraphColor, UpdateSourceTrigger=PropertyChanged}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Novo gráfico" Click="OnNewGraphClick" />
          <Button Content="Salvar gráfico" Click="OnSaveGraphClick" />
          <Button Content="Remover selecionado" Click="OnRemoveGraphClick" />
        </StackPanel>

        <TextBlock Text="TEMPLATES" FontSize="10" FontWeight="Bold" />
        <ItemsControl ItemsSource="{Binding TemplateChoices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:OverlayBlockContentChoiceViewModel}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                <Button Grid.Column="1" Content="Editar" Padding="10,4" Click="OnEditTemplateClick" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox PlaceholderText="Texto com placeholders, ex.: GPU {GpuTemperature:F0} °C" Text="{Binding TemplateText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBox PlaceholderText="Cor opcional #RRGGBB" Text="{Binding TemplateColor, UpdateSourceTrigger=PropertyChanged}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Novo template" Click="OnNewTemplateClick" />
          <Button Content="Salvar template" Click="OnSaveTemplateClick" />
          <Button Content="Remover selecionado" Click="OnRemoveTemplateClick" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="18,8,18,18">
      <Button Content="Cancelar" Click="OnCancelClick" />
      <Button Content="Adicionar conteúdo" Click="OnAddClick" />
    </StackPanel>
  </Grid>
</Window>
