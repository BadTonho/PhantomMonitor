<Window x:Class="PhantomMonitor.InventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventário de Hardware - Phantom Monitor"
        Height="680" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <TextBlock Text="Inventário de Hardware" FontSize="18" FontWeight="Bold"/>
                <Button x:Name="ResetStatsButton" Content="Resetar estatísticas"
                        HorizontalAlignment="Right" Padding="10,3"
                        Click="OnResetStatsClick"
                        ToolTip="Zera as colunas Mín/Máx/Média da sessão e grava um marcador no CSV ativo (#marker)."/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="SummaryText" Text="Sem dados — inicie o monitoramento."
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Séries publicadas">
                <DataGrid x:Name="SeriesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="Transparent" RowBackground="Transparent" BorderThickness="0,1,0,0"
                          Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Série" Binding="{Binding Key}" MinWidth="160"/>
                        <DataGridTextColumn Header="Sensor de origem" Binding="{Binding Label}" MinWidth="200" Width="*"/>
                        <DataGridTextColumn Header="Valor" Binding="{Binding ValueText}" MinWidth="100"/>
                        <DataGridTextColumn Header="Mín (sessão)" Binding="{Binding MinText}" MinWidth="100"/>
                        <DataGridTextColumn Header="Máx (sessão)" Binding="{Binding MaxText}" MinWidth="100"/>
                        <DataGridTextColumn Header="Média" Binding="{Binding AvgText}" MinWidth="100"/>
                        <DataGridTextColumn Header="Unidade" Binding="{Binding Unit}" MinWidth="60"/>
                        <DataGridCheckBoxColumn Header="Canônica" Binding="{Binding Canonical}" MinWidth="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Hardware detectado">
                <TreeView x:Name="HardwareTree" Margin="0,8,0,0"
                          Background="Transparent" BorderThickness="0"/>
            </TabItem>
            <TabItem Header="Monitores">
                <DataGrid x:Name="MonitorsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="Transparent" RowBackground="Transparent" BorderThickness="0,1,0,0"
                          Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Instância WMI (device)" Binding="{Binding InstanceName}" MinWidth="220" Width="*"/>
                        <DataGridTextColumn Header="Fabricante" Binding="{Binding Manufacturer}" MinWidth="80"/>
                        <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" MinWidth="120"/>
                        <DataGridTextColumn Header="Código" Binding="{Binding ProductCode}" MinWidth="70"/>
                        <DataGridTextColumn Header="S/N" Binding="{Binding Serial}" MinWidth="90"/>
                        <DataGridTextColumn Header="Diagonal" Binding="{Binding DiagonalText}" MinWidth="70"/>
                        <DataGridTextColumn Header="Fabricação" Binding="{Binding MadeText}" MinWidth="90"/>
                        <DataGridCheckBoxColumn Header="Primário" Binding="{Binding Primary}" MinWidth="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Background="Transparent" Foreground="{StaticResource TextMutedBrush}">
            <StatusBarItem>
                <TextBlock x:Name="RefreshText" Text="Atualiza automaticamente a cada 2 s (snapshot atual)."
                           FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
