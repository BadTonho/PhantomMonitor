<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:charts="using:PhantomMonitor.App.Controls"
        x:Class="PhantomMonitor.App.Views.MainWindow"
        Title="Phantom Monitor"
        Width="1120" Height="790" MinWidth="850" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#111827">
  <Window.Styles>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8B98AA" />
    </Style>
    <Style Selector="TextBlock.metric">
      <Setter Property="Foreground" Value="#F3F6FB" />
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="#202C3B" />
      <Setter Property="Foreground" Value="#E6EDF6" />
    </Style>
    <Style Selector="TextBox.settings-input">
      <Setter Property="Width" Value="190" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="210,*">
    <Border Grid.Column="0" Background="#151E2B" BorderBrush="#263244" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="18,22">
        <StackPanel Spacing="3">
          <TextBlock Text="PHANTOM" Foreground="#F8FAFC" FontSize="19" FontWeight="Bold" />
          <TextBlock Text="HARDWARE MONITOR" Foreground="#748399" FontSize="9" FontWeight="Bold" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,38,0,0" Spacing="10">
          <TextBlock Text="MONITORAMENTO" Foreground="#718096" FontSize="10" FontWeight="Bold" Margin="8,0,0,4" />
          <Button Classes="nav" Content="◉   Visão geral" Click="OnOverviewClick" />
          <Button Classes="nav" Content="▦   Inventário" Click="OnInventoryClick" />
          <Button Classes="nav" Content="ƒ   Sensores customizados" Click="OnCustomSensorsClick" />
          <Button Classes="nav" Content="↻   Ajuste por série" Click="OnSensorTuningClick" />
          <Button Classes="nav" Content="♧   Alertas" Click="OnAlertsClick" />
          <Button Classes="nav" Content="⚙   Configurações" Click="OnSettingsClick" />
          <TextBlock Text="CPU · GPU · MEMÓRIA · FPS" Foreground="#66758A" FontSize="9" Margin="8,13,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="#1B2634" CornerRadius="9" Padding="11">
          <StackPanel Spacing="5">
            <TextBlock Text="ESTADO" Foreground="#75859A" FontSize="9" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusText}" Foreground="#DCE5F0" FontSize="12" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsOverview}">
      <StackPanel Margin="28,23,28,28" Spacing="16">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,3">
          <StackPanel Spacing="4">
            <TextBlock Text="Visão geral do sistema" Foreground="#F3F6FB" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding LastUpdateText}" Classes="muted" FontSize="11" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="action" Content="{Binding OverlayButtonText}" Click="OnToggleOverlayClick" />
            <Button Classes="action" Content="Iniciar" IsEnabled="{Binding CanStart}" Click="OnStartClick" />
            <Button Classes="action" Content="{Binding PauseButtonText}" IsEnabled="{Binding CanPause}" Click="OnPauseClick" />
            <Button Classes="action" Content="Parar" IsEnabled="{Binding CanStop}" Click="OnStopClick" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
          <Border Background="#1B2634" BorderBrush="#29374A" BorderThickness="1" CornerRadius="12" Padding="18">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="PROCESSADOR" Foreground="#AAB7C8" FontSize="10" FontWeight="Bold" />
                <Border Grid.Column="1" Background="#243345" CornerRadius="8" Padding="8,3">
                  <TextBlock Text="CPU" Foreground="#93C5FD" FontSize="9" FontWeight="Bold" />
                </Border>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="{Binding CpuUsageText}" Classes="metric" />
                  <TextBlock Text="Utilização total" Classes="muted" FontSize="10" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="5">
                  <TextBlock Text="{Binding CpuTempText}" Foreground="#E6EDF6" FontSize="14" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding CpuClockText}" Classes="muted" FontSize="10" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
              <charts:HistoryChart Grid.Row="2" Values="{Binding CpuSamples}" Stroke="#38BDF8" Height="42" />
            </Grid>
          </Border>

          <Border Grid.Column="1" Background="#1B2634" BorderBrush="#29374A" BorderThickness="1" CornerRadius="12" Padding="18">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="PLACA DE VÍDEO" Foreground="#AAB7C8" FontSize="10" FontWeight="Bold" />
                <Border Grid.Column="1" Background="#243345" CornerRadius="8" Padding="8,3">
                  <TextBlock Text="GPU" Foreground="#C4B5FD" FontSize="9" FontWeight="Bold" />
                </Border>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="{Binding GpuUsageText}" Classes="metric" />
                  <TextBlock Text="Utilização do núcleo" Classes="muted" FontSize="10" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="5">
                  <TextBlock Text="{Binding GpuTempText}" Foreground="#E6EDF6" FontSize="14" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding GpuMemoryText}" Classes="muted" FontSize="10" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
              <charts:HistoryChart Grid.Row="2" Values="{Binding GpuSamples}" Stroke="#A78BFA" Height="42" />
            </Grid>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
          <Border Background="#1B2634" BorderBrush="#29374A" BorderThickness="1" CornerRadius="12" Padding="17">
            <StackPanel Spacing="11">
              <TextBlock Text="MEMÓRIA RAM" Foreground="#AAB7C8" FontSize="10" FontWeight="Bold" />
              <TextBlock Text="{Binding RamUsageText}" Classes="metric" />
              <TextBlock Text="{Binding RamDetailText}" Classes="muted" FontSize="11" />
              <charts:HistoryChart Values="{Binding RamSamples}" Stroke="#34D399" Height="34" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="#1B2634" BorderBrush="#29374A" BorderThickness="1" CornerRadius="12" Padding="17">
            <StackPanel Spacing="12">
              <TextBlock Text="DISCO" Foreground="#AAB7C8" FontSize="10" FontWeight="Bold" />
              <StackPanel Spacing="4">
                <TextBlock Text="LEITURA" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                <TextBlock Text="{Binding DiskReadText}" Foreground="#E6EDF6" FontSize="16" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="GRAVAÇÃO" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                <TextBlock Text="{Binding DiskWriteText}" Foreground="#E6EDF6" FontSize="16" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="#1B2634" BorderBrush="#29374A" BorderThickness="1" CornerRadius="12" Padding="17">
            <StackPanel Spacing="12">
              <TextBlock Text="REDE" Foreground="#AAB7C8" FontSize="10" FontWeight="Bold" />
              <StackPanel Spacing="4">
                <TextBlock Text="DOWNLOAD" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                <TextBlock Text="{Binding NetworkDownText}" Foreground="#E6EDF6" FontSize="16" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="UPLOAD" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                <TextBlock Text="{Binding NetworkUpText}" Foreground="#E6EDF6" FontSize="16" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <Border Background="#1B2634" BorderBrush="#29374A" BorderThickness="1" CornerRadius="12" Padding="18">
          <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="FPS EM JOGO" Foreground="#AAB7C8" FontSize="10" FontWeight="Bold" />
                <TextBlock Text="{Binding FpsHint}" Classes="muted" FontSize="10" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="22" VerticalAlignment="Center">
                <StackPanel>
                  <TextBlock Text="FPS" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                  <TextBlock Text="{Binding FpsText}" Foreground="#F3F6FB" FontSize="25" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="FRAMETIME" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                  <TextBlock Text="{Binding FrametimeText}" Foreground="#E6EDF6" FontSize="16" />
                </StackPanel>
              </StackPanel>
            </Grid>
            <charts:HistoryChart Grid.Row="1" Values="{Binding FrametimeSamples}" Stroke="#FBBF24" Height="56" />
            <TextBlock Grid.Row="2" Text="{Binding FpsStatsText}" Foreground="#AAB7C8" FontSize="10" />
          </Grid>
        </Border>

        <TextBlock Text="Os valores de temperatura, clock e utilização dependem dos sensores expostos pelo kernel e pelo driver." Classes="muted" FontSize="10" TextWrapping="Wrap" Margin="2,0,0,0" />
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsInventory}">
      <StackPanel Margin="28,23,28,28" Spacing="16">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,3">
          <StackPanel Spacing="4">
            <TextBlock Text="Inventário de sensores" Foreground="#F3F6FB" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding InventorySummaryText}" Classes="muted" FontSize="11" />
            <TextBlock Text="{Binding InventoryUpdatedText}" Classes="muted" FontSize="10" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="action" Content="Iniciar" IsEnabled="{Binding CanStart}" Click="OnStartClick" />
            <Button Classes="action" Content="{Binding PauseButtonText}" IsEnabled="{Binding CanPause}" Click="OnPauseClick" />
            <Button Classes="action" Content="Parar" IsEnabled="{Binding CanStop}" Click="OnStopClick" />
          </StackPanel>
        </Grid>

        <Border IsVisible="{Binding IsWaitingForInventorySnapshot}" Background="#1B2634" BorderBrush="#29374A" BorderThickness="1" CornerRadius="10" Padding="18">
          <TextBlock Text="Aguardando a primeira leitura dos sensores…" Classes="muted" FontSize="12" />
        </Border>

        <ItemsControl ItemsSource="{Binding InventoryGroups}" IsVisible="{Binding HasInventorySnapshot}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#1B2634" BorderBrush="#29374A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                <StackPanel Spacing="10">
                  <TextBlock Text="{Binding Title}" Foreground="#E6EDF6" FontSize="14" FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="1.1*,1.5*,*,Auto" Margin="0,0,0,2">
                    <TextBlock Text="SÉRIE" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="ORIGEM" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                    <TextBlock Grid.Column="2" Text="VALOR" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                    <TextBlock Grid.Column="3" Text="UNIDADE" Foreground="#748399" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#29374A" BorderThickness="0,1,0,0" Padding="0,8">
                          <Grid ColumnDefinitions="1.1*,1.5*,*,Auto">
                            <TextBlock Text="{Binding Key}" Foreground="#C7D2E0" FontFamily="monospace" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="#AAB7C8" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="#F3F6FB" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Unit}" Foreground="#8B98AA" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Os sensores indisponíveis dependem do hardware, dos drivers e dos dados expostos pelo kernel." Classes="muted" FontSize="10" TextWrapping="Wrap" Margin="2,0,0,0" />
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsSettings}">
      <StackPanel Margin="28,23,28,28" Spacing="16">
        <StackPanel Spacing="4" Margin="0,0,0,3">
          <TextBlock Text="Configurações" Foreground="#F3F6FB" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="Ajuste a coleta, o overlay e os arquivos de telemetria." Classes="muted" FontSize="11" />
        </StackPanel>

        <Border Background="#1B2634" BorderBrush="#29374A" BorderThickness="1" CornerRadius="12" Padding="18">
          <StackPanel Spacing="12">
            <TextBlock Text="COLETA" Foreground="#AAB7C8" FontSize="10" FontWeight="Bold" />
            <TextBlock Text="Intervalo global (milissegundos)" Foreground="#E6EDF6" FontSize="12" />
            <TextBox Classes="settings-input" Text="{Binding UpdateIntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Use um valor entre 100 e 60.000 ms. Um intervalo menor atualiza o painel com mais frequência." Classes="muted" FontSize="10" TextWrapping="Wrap" />
            <TextBlock IsVisible="{Binding IsLegacyIntervalOutOfRange}" Text="O config atual usa mais de 60.000 ms. Esse valor será mantido até você editar o intervalo." Foreground="#FBBF24" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Background="#1B2634" BorderBrush="#29374A" BorderThickness="1" CornerRadius="12" Padding="18">
          <StackPanel Spacing="10">
            <TextBlock Text="OVERLAY FLUTUANTE" Foreground="#AAB7C8" FontSize="10" FontWeight="Bold" />
            <TextBlock Text="Escolha as categorias mostradas na janela compacta. Salve para aplicar." Classes="muted" FontSize="10" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="5">
                <TextBlock Text="LARGURA (140–700 PX)" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                <TextBox Text="{Binding OverlayWidthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5" MinWidth="180">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="OPACIDADE" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                  <TextBlock Grid.Column="1" Text="{Binding OverlayOpacityLabel}" Foreground="#C7D2E0" FontSize="10" />
                </Grid>
                <Slider Minimum="10" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding OverlayOpacityPercent, Mode=TwoWay}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="A largura e a opacidade são aplicadas à janela aberta ao salvar, sem reiniciar a coleta." Classes="muted" FontSize="10" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <StackPanel Spacing="5" Width="125">
                <TextBlock Text="FONTE (8–20 PT)" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                <TextBox Text="{Binding OverlayFontSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="TAMANHO DA FONTE" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                  <TextBlock Grid.Column="1" Text="{Binding OverlayFontSizeLabel}" Foreground="#C7D2E0" FontSize="10" />
                </Grid>
                <Slider Minimum="8" Maximum="20" TickFrequency="0.5" IsSnapToTickEnabled="True"
                        Value="{Binding OverlayFontSizeSlider, Mode=TwoWay}" />
              </StackPanel>
            </Grid>
            <CheckBox Content="Modo compacto (reduz margens e espaçamento das linhas)"
                      IsChecked="{Binding OverlayCompactModeSetting, Mode=TwoWay}" />
            <WrapPanel Orientation="Horizontal" ItemWidth="170">
              <CheckBox Content="CPU" IsChecked="{Binding OverlayShowCpu, Mode=TwoWay}" />
              <CheckBox Content="GPU" IsChecked="{Binding OverlayShowGpu, Mode=TwoWay}" />
              <CheckBox Content="RAM" IsChecked="{Binding OverlayShowRam, Mode=TwoWay}" />
              <CheckBox Content="Disco" IsChecked="{Binding OverlayShowDisk, Mode=TwoWay}" />
              <CheckBox Content="Rede" IsChecked="{Binding OverlayShowNetwork, Mode=TwoWay}" />
              <CheckBox Content="Ventoinhas" IsChecked="{Binding OverlayShowFans, Mode=TwoWay}" />
              <CheckBox Content="Placa-mãe" IsChecked="{Binding OverlayShowMotherboard, Mode=TwoWay}" />
              <CheckBox Content="FPS e frametime" IsChecked="{Binding OverlayShowFps, Mode=TwoWay}" />
            </WrapPanel>
            <CheckBox Content="Gráfico de frametime no overlay (requer FPS/frametime)"
                      IsEnabled="{Binding OverlayShowFps}"
                      IsChecked="{Binding OverlayShowFrametimeGraph, Mode=TwoWay}" />
            <TextBlock Text="O gráfico aparece abaixo da linha JOGO quando há pelo menos duas amostras. A pausa mantém o histórico congelado."
                       Classes="muted" FontSize="10" TextWrapping="Wrap" />
            <TextBlock Text="SÉRIES POR INSTÂNCIA" Foreground="#748399" FontSize="9" FontWeight="Bold" Margin="0,4,0,0" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <ComboBox ItemsSource="{Binding OverlaySeriesOptions}" SelectedItem="{Binding SelectedOverlaySeries, Mode=TwoWay}"
                        PlaceholderText="Escolha uma série detectada" />
              <Button Grid.Column="1" Classes="action" Content="Adicionar" Click="OnAddDetectedOverlaySeriesClick" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding OverlaySeriesPatternInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="Ex.: Gpu*, CpuTemperature#* ou DiskRead#1" />
              <Button Grid.Column="1" Classes="action" Content="Adicionar padrão" Click="OnAddOverlaySeriesPatternClick" />
            </Grid>
            <ItemsControl ItemsSource="{Binding OverlaySeriesPatterns}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="{Binding Pattern}" Foreground="#C7D2E0" FontSize="11" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Remover" Padding="8,3" Click="OnRemoveOverlaySeriesPatternClick" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Restaurar padrões" Click="OnRestoreOverlaySeriesDefaultsClick" />
              <TextBlock Text="A lista funciona como whitelist. Padrões aceitam chave exata, *, prefixo* ou *sufixo; os não detectados ficam salvos." Classes="muted" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="O overlay é arrastável e recebe cliques. No Wayland, o compositor define sua posição inicial e seu comportamento sobre janelas em tela cheia." Foreground="#FBBF24" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Background="#1B2634" BorderBrush="#29374A" BorderThickness="1" CornerRadius="12" Padding="18">
          <StackPanel Spacing="12">
            <TextBlock Text="GRAVAÇÃO DE TELEMETRIA" Foreground="#AAB7C8" FontSize="10" FontWeight="Bold" />
            <CheckBox Content="Exportar CSV" IsChecked="{Binding LogToCsv, Mode=TwoWay}" />
            <CheckBox Content="Snapshot JSON mais recente" IsChecked="{Binding LogToJson, Mode=TwoWay}" />
            <CheckBox Content="Journal JSON contínuo (JSONL)" IsChecked="{Binding LogToJsonJournal, Mode=TwoWay}" />
            <StackPanel Spacing="4" Margin="0,6,0,0">
              <TextBlock Text="PASTA DOS ARQUIVOS" Foreground="#748399" FontSize="9" FontWeight="Bold" />
              <TextBlock Text="{Binding LogDirectoryText}" Foreground="#C7D2E0" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="#1B2634" BorderBrush="#29374A" BorderThickness="1" CornerRadius="12" Padding="18">
          <StackPanel Spacing="12">
            <TextBlock Text="EXPORTADOR HTTP" Foreground="#AAB7C8" FontSize="10" FontWeight="Bold" />
            <CheckBox Content="Ativar endpoints de telemetria" IsChecked="{Binding TelemetryExportEnabled, Mode=TwoWay}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="5">
                <TextBlock Text="PORTA (1024–65535)" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                <TextBox Text="{Binding TelemetryExportPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="7317" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="ENDPOINTS" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                <TextBlock Text="{Binding TelemetryExportEndpointText}" Foreground="#C7D2E0" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
            <CheckBox Content="Escutar em todas as interfaces (LAN)" IsChecked="{Binding TelemetryExportListenAll, Mode=TwoWay}" />
            <TextBlock Text="A opção LAN permite acesso por outros dispositivos da rede e não usa TLS nem autenticação. Ative somente em uma rede confiável." Foreground="#FBBF24" FontSize="10" TextWrapping="Wrap" />
            <StackPanel Spacing="4">
              <TextBlock Text="ESTADO" Foreground="#748399" FontSize="9" FontWeight="Bold" />
              <TextBlock Text="{Binding TelemetryExportStatusText}" Foreground="#C7D2E0" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="GET /values retorna o último snapshot JSON; GET /health verifica o listener. O servidor funciona enquanto a coleta estiver ativa e mantém o último snapshot durante a pausa." Classes="muted" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
          <Button Classes="action" Content="Salvar e aplicar" Click="OnSaveSettingsClick" />
          <TextBlock Grid.Column="1" Text="{Binding SettingsMessage}" Classes="muted" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsCustomSensors}">
      <StackPanel Margin="28,23,28,28" Spacing="16">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,3">
          <StackPanel Spacing="4">
            <TextBlock Text="Sensores customizados" Foreground="#F3F6FB" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Crie séries derivadas de outras leituras usando fórmulas." Classes="muted" FontSize="11" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="action" Content="Iniciar" IsEnabled="{Binding CanStart}" Click="OnStartClick" />
            <Button Classes="action" Content="{Binding PauseButtonText}" IsEnabled="{Binding CanPause}" Click="OnPauseClick" />
            <Button Classes="action" Content="Parar" IsEnabled="{Binding CanStop}" Click="OnStopClick" />
          </StackPanel>
        </Grid>

        <Border Background="#1B2634" BorderBrush="#29374A" BorderThickness="1" CornerRadius="12" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="FÓRMULAS E ÍNDICES" Foreground="#AAB7C8" FontSize="10" FontWeight="Bold" />
            <TextBlock Text="Use +, -, *, /, parênteses, min(...), max(...), abs(...) e referências como {CpuTemperature} ou {GpuTemperature#1}. Números decimais usam ponto." Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="A ordem define Custom#1, Custom#2… e a sequência de cálculo. Reordenar pode alterar alertas que apontam para Custom#i. Fórmulas podem referenciar sensores customizados anteriores; referências físicas ausentes só deixam a série sem leitura até os dados aparecerem." Foreground="#FBBF24" FontSize="10" TextWrapping="Wrap" />
            <TextBlock Text="Salvar alterações reinicia a sessão de sensores e zera suas estatísticas. Coleta parada permanece parada; coleta pausada continua pausada." Classes="muted" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="SÉRIES DERIVADAS" Foreground="#AAB7C8" FontSize="10" FontWeight="Bold" />
            <TextBlock Text="Até 64 fórmulas. Nomes devem ser únicos." Classes="muted" FontSize="10" />
          </StackPanel>
          <Button Grid.Column="1" Classes="action" Content="Adicionar sensor" Click="OnAddCustomSensorClick" />
        </Grid>

        <ItemsControl ItemsSource="{Binding CustomSensorEditors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#1B2634" BorderBrush="#29374A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding SeriesKey}" Foreground="#93C5FD" FontFamily="monospace" FontSize="11" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="↑" IsEnabled="{Binding CanMoveUp}" Click="OnMoveCustomSensorUpClick" />
                    <Button Grid.Column="2" Content="↓" IsEnabled="{Binding CanMoveDown}" Click="OnMoveCustomSensorDownClick" />
                    <Button Grid.Column="3" Content="Remover" Click="OnRemoveCustomSensorClick" />
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="5">
                      <TextBlock Text="NOME" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                      <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="DeltaTemp" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5">
                      <TextBlock Text="UNIDADE (OPCIONAL)" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                      <TextBox Text="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="°C, %, MB…" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="5">
                    <TextBlock Text="FÓRMULA" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                    <TextBox Text="{Binding Formula, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Ex.: {GpuTemperature} - {CpuTemperature}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
          <Button Classes="action" Content="Salvar e aplicar" Click="OnSaveCustomSensorsClick" />
          <TextBlock Grid.Column="1" Text="{Binding CustomSensorsMessage}" Classes="muted" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsSensorTuning}">
      <StackPanel Margin="28,23,28,28" Spacing="16">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,3">
          <StackPanel Spacing="4">
            <TextBlock Text="Ajuste por série" Foreground="#F3F6FB" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Configure a cadência de publicação e a suavização das leituras." Classes="muted" FontSize="11" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="action" Content="Iniciar" IsEnabled="{Binding CanStart}" Click="OnStartClick" />
            <Button Classes="action" Content="{Binding PauseButtonText}" IsEnabled="{Binding CanPause}" Click="OnPauseClick" />
            <Button Classes="action" Content="Parar" IsEnabled="{Binding CanStop}" Click="OnStopClick" />
          </StackPanel>
        </Grid>

        <Border Background="#1B2634" BorderBrush="#29374A" BorderThickness="1" CornerRadius="12" Padding="16">
          <StackPanel Spacing="7">
            <TextBlock Text="COMO AS REGRAS SE APLICAM" Foreground="#AAB7C8" FontSize="10" FontWeight="Bold" />
            <TextBlock Text="Intervalo 0 usa cada tick global; valores positivos são limitados a 100–3.600.000 ms e elevados ao intervalo global quando necessário. Suavização 0 ou 1 desliga o filtro; 2–60 usa uma média móvel das amostras frescas." Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="Padrões podem sobrepor várias séries. A última regra correspondente na lista prevalece; use as setas para mudar a ordem. Série ausente fica preservada e será ajustada quando aparecer." Foreground="#FBBF24" FontSize="10" TextWrapping="Wrap" />
            <TextBlock Text="Salvar recria a sessão de sensores e zera as estatísticas. Coleta parada permanece parada; coleta pausada continua pausada." Classes="muted" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="REGRAS DE AJUSTE" Foreground="#AAB7C8" FontSize="10" FontWeight="Bold" />
            <TextBlock Text="Até 64 regras. Selecione uma série detectada/salva ou digite uma série/padrão." Classes="muted" FontSize="10" />
          </StackPanel>
          <Button Grid.Column="1" Classes="action" Content="Adicionar regra" Click="OnAddSensorTuningClick" />
        </Grid>

        <ItemsControl ItemsSource="{Binding SensorTuningEditors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#1B2634" BorderBrush="#29374A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding SeriesLabel}" Foreground="#93C5FD" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="↑" IsEnabled="{Binding CanMoveUp}" Click="OnMoveSensorTuningUpClick" />
                    <Button Grid.Column="2" Content="↓" IsEnabled="{Binding CanMoveDown}" Click="OnMoveSensorTuningDownClick" />
                    <Button Grid.Column="3" Content="Remover" Click="OnRemoveSensorTuningClick" />
                  </Grid>
                  <Grid ColumnDefinitions="1.3*,*" ColumnSpacing="10">
                    <StackPanel Spacing="5">
                      <TextBlock Text="SÉRIE OU PADRÃO" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                      <TextBox Text="{Binding Series, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="GpuTemperature ou Gpu*" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5">
                      <TextBlock Text="SUGESTÕES DO INVENTÁRIO" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                      <ComboBox ItemsSource="{Binding SeriesOptions}" SelectedItem="{Binding SelectedSeriesOption, Mode=TwoWay}" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="5">
                      <TextBlock Text="INTERVALO (MS)" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                      <TextBox Text="{Binding IntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="0 = global" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5">
                      <TextBlock Text="SUAVIZAÇÃO (AMOSTRAS)" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                      <TextBox Text="{Binding SmoothingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="0 = desativada" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
          <Button Classes="action" Content="Salvar e aplicar" Click="OnSaveSensorTuningsClick" />
          <TextBlock Grid.Column="1" Text="{Binding SensorTuningMessage}" Classes="muted" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsAlerts}">
      <StackPanel Margin="28,23,28,28" Spacing="16">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,3">
          <StackPanel Spacing="4">
            <TextBlock Text="Alertas" Foreground="#F3F6FB" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Configure limites e acompanhe os disparos durante a coleta." Classes="muted" FontSize="11" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="action" Content="Iniciar" IsEnabled="{Binding CanStart}" Click="OnStartClick" />
            <Button Classes="action" Content="{Binding PauseButtonText}" IsEnabled="{Binding CanPause}" Click="OnPauseClick" />
            <Button Classes="action" Content="Parar" IsEnabled="{Binding CanStop}" Click="OnStopClick" />
          </StackPanel>
        </Grid>

        <Border Background="#1B2634" BorderBrush="#29374A" BorderThickness="1" CornerRadius="12" Padding="18">
          <StackPanel Spacing="12">
            <TextBlock Text="CONFIGURAÇÃO GERAL" Foreground="#AAB7C8" FontSize="10" FontWeight="Bold" />
            <CheckBox Content="Ativar avaliação de alertas" IsChecked="{Binding AlertsEnabled, Mode=TwoWay}" />
            <StackPanel Spacing="5">
              <TextBlock Text="Cooldown global (segundos)" Foreground="#E6EDF6" FontSize="12" />
              <TextBox Classes="settings-input" Text="{Binding AlertsCooldownText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="Use de 1 a 3.600 segundos. Cooldown 0 em uma regra usa este valor." Classes="muted" FontSize="10" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="REGRAS" Foreground="#AAB7C8" FontSize="10" FontWeight="Bold" />
            <TextBlock Text="A notificação aparece quando a condição é atendida; regras sem notificação continuam no histórico." Classes="muted" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Classes="action" Content="Adicionar regra" Click="OnAddAlertRuleClick" />
        </Grid>

        <ItemsControl ItemsSource="{Binding AlertRules}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#1B2634" BorderBrush="#29374A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                <StackPanel Spacing="11">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <CheckBox Content="Regra ativa" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" Content="Notificação" IsChecked="{Binding Popup, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Grid.Column="2" Content="Remover" Click="OnRemoveAlertRuleClick" />
                  </Grid>
                  <Grid ColumnDefinitions="1.4*,*,*,*" ColumnSpacing="10">
                    <StackPanel Spacing="5">
                      <TextBlock Text="SENSOR" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                      <ComboBox ItemsSource="{Binding SensorOptions}" SelectedItem="{Binding SensorKey, Mode=TwoWay}" />
                      <TextBlock Text="{Binding SensorUnit}" Classes="muted" FontSize="9" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5">
                      <TextBlock Text="COMPARAÇÃO" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                      <ComboBox ItemsSource="{Binding Comparisons}" SelectedItem="{Binding Comparison, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="5">
                      <TextBlock Text="LIMITE" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                      <TextBox Text="{Binding ThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="5">
                      <TextBlock Text="COOLDOWN (S)" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                      <TextBox Text="{Binding CooldownText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="5">
                    <TextBlock Text="MENSAGEM (OPCIONAL)" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                    <TextBox Text="{Binding Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Sensor {sensor}: {value} (limite: {threshold})" />
                    <TextBlock Text="Placeholders: {sensor}, {value}, {threshold}." Classes="muted" FontSize="10" />
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <TextBlock Text="SCRIPT (OPCIONAL)" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox Text="{Binding Script, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="/caminho/para/script.sh" />
                      <Button Grid.Column="1" Content="Escolher arquivo…" Click="OnSelectAlertScriptClick" />
                    </Grid>
                    <TextBlock Text="Scripts .sh usam /bin/sh; outros arquivos precisam ser executáveis." Classes="muted" FontSize="10" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <TextBlock Text="ARGUMENTOS DO SCRIPT" Foreground="#748399" FontSize="9" FontWeight="Bold" />
                    <TextBox Text="{Binding ScriptArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="--valor {value} --sensor &quot;{sensor}&quot;" />
                    <TextBlock Text="Separe por espaços; use aspas ou barra invertida para agrupar/escapar. Placeholders: {value}, {sensor}. Pipes e redirecionamentos não são interpretados." Classes="muted" FontSize="10" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Background="#1B2634" BorderBrush="#29374A" BorderThickness="1" CornerRadius="12" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="HISTÓRICO RECENTE" Foreground="#AAB7C8" FontSize="10" FontWeight="Bold" />
            <TextBlock IsVisible="{Binding !HasAlertHistory}" Text="Nenhum alerta disparado nesta execução." Classes="muted" FontSize="11" />
            <ItemsControl ItemsSource="{Binding AlertHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#29374A" BorderThickness="0,1,0,0" Padding="0,8">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                      <TextBlock Text="{Binding Time}" Classes="muted" FontSize="10" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Sensor}" Foreground="#93C5FD" FontFamily="monospace" FontSize="10" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="#E6EDF6" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding Value}" Foreground="#FBBF24" FontSize="10" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
          <Button Classes="action" Content="Salvar e aplicar" Click="OnSaveAlertsClick" />
          <TextBlock Grid.Column="1" Text="{Binding AlertsMessage}" Classes="muted" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>

        <TextBlock Text="No Avalonia, scripts configurados são executados quando a regra dispara. Som e desligamento são preservados no arquivo, mas não executados." Classes="muted" FontSize="10" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Column="1" ZIndex="10" IsVisible="{Binding AlertToastVisible}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,18,0" MaxWidth="420" Background="#243345" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="10" Padding="16">
      <StackPanel Spacing="5">
        <TextBlock Text="PHANTOM MONITOR · ALERTA" Foreground="#7DD3FC" FontSize="9" FontWeight="Bold" />
        <TextBlock Text="{Binding AlertToastMessage}" Foreground="#F3F6FB" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
