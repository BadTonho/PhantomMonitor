<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PhantomMonitor</RootNamespace>
    <AssemblyName>PhantomMonitor.Core</AssemblyName>
  </PropertyGroup>

  <!-- Pacotes Windows-only usados por Services/Sensors/Windows (HardwareMonitorService/FpsMonitor).
       Gerenciamos e instanciamos apenas no lado Windows (guard de OS na SensorServiceFactory);
       assemblies ficam inertes no Linux e não exigem nenhum driver nativo. -->
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.13" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.13" />
    <PackageReference Include="System.Management" Version="10.0.13" />
  </ItemGroup>
</Project>
