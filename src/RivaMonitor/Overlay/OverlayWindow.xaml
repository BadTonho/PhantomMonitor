<Window x:Class="RivaMonitor.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RivaMonitor Overlay" Height="400" Width="220"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SizeToContent="Height"
        IsHitTestVisible="False">
    <Border x:Name="MainBorder" CornerRadius="10" Background="#CC0D1117"
            BorderBrush="#1E90FF" BorderThickness="1" Padding="10,8">
        <StackPanel x:Name="SensorPanel">
            <!-- built programmatically -->
        </StackPanel>
    </Border>
</Window>
