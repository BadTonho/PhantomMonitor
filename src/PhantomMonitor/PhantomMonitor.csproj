<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PhantomMonitor</RootNamespace>
    <AssemblyName>PhantomMonitor</AssemblyName>
    <!-- Marcador de build de desenvolvimento: o updater nunca "atualiza" um 0.0.0-dev.
         A release passa /p:Version=<tag> no publish e a versão compilada passa a casar. -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\tools\PresentMon.exe" Condition="Exists('..\..\tools\PresentMon.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <!-- config.example.json acompanha o executável: serve de modelo para o config do usuário -->
    <None Include="..\..\config.example.json" Condition="Exists('..\..\config.example.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhantomMonitor.Core\PhantomMonitor.Core.csproj" />
  </ItemGroup>

</Project>
