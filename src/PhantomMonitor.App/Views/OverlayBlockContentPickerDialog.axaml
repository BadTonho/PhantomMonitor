<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhantomMonitor.App.ViewModels"
        x:Class="PhantomMonitor.App.Views.OverlayBlockContentPickerDialog"
        xmlns:vmroot="using:PhantomMonitor.App.ViewModels"
        x:DataType="vmroot:OverlayBlockContentDialogViewModel"
        Title="Adicionar conteúdo ao bloco"
        Icon="avares://PhantomMonitor/Assets/fantasma.ico"
        Width="720" Height="760" MinWidth="580" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}">
  <Window.Styles>
    <StyleInclude Source="avares://PhantomMonitor/Themes/DesktopStyles.axaml" />
    <Style Selector="Border.desktop-card">
      <Setter Property="Padding" Value="14,11" />
    </Style>
    <Style Selector="CheckBox.chip-toggle">
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="ChipBorder"
                  Background="{DynamicResource BgWindowBrush}"
                  BorderBrush="{DynamicResource BgCardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="7"
                  Padding="12,7"
                  Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <Border x:Name="CheckDot"
                      Width="14" Height="14" CornerRadius="4"
                      Background="Transparent"
                      BorderBrush="{DynamicResource TextSecondaryBrush}"
                      BorderThickness="1.3"
                      VerticalAlignment="Center">
                <Path x:Name="CheckMark"
                      Data="M 2.5,7 L 5.5,10 L 11.5,3.5"
                      Stroke="{DynamicResource BgWindowBrush}"
                      StrokeThickness="1.8"
                      Stretch="None"
                      IsVisible="False" />
              </Border>
              <ContentPresenter Content="{TemplateBinding Content}"
                                Foreground="{DynamicResource TextBodyBrush}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="CheckBox.chip-toggle:pointerover /template/ Border#ChipBorder">
      <Setter Property="Background" Value="{DynamicResource NavSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
    </Style>
    <Style Selector="CheckBox.chip-toggle:checked /template/ Border#ChipBorder">
      <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
    </Style>
    <Style Selector="CheckBox.chip-toggle:checked /template/ Border#CheckDot">
      <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
    </Style>
    <Style Selector="CheckBox.chip-toggle:checked /template/ Path#CheckMark">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="20,16,20,12" Spacing="10">
        <!-- Cabeçalho + Ação direta de Linha de Texto -->
        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,0,0,2">
          <TextBlock Text="Adicionar conteúdo ao bloco" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="secondary" Click="OnAddCustomLineClick">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="+" Foreground="{DynamicResource AccentLightBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,-1,0,0" />
              <TextBlock Text="Linha de texto personalizada" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- Card 1: Categorias Completas + Frametime -->
        <Border Classes="desktop-card">
          <StackPanel Spacing="8">
            <TextBlock Text="CATEGORIAS COMPLETAS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
            <ItemsControl ItemsSource="{Binding CategoriesChoices}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:OverlayBlockContentChoiceViewModel}">
                  <CheckBox Classes="chip-toggle" Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
              <CheckBox Classes="chip-toggle" Content="{Binding FrametimeChoice.Label}" IsChecked="{Binding FrametimeChoice.IsSelected}" Margin="0" />
            </Border>
          </StackPanel>
        </Border>

        <!-- Card 2: Sensores Individuais (Séries) -->
        <Border Classes="desktop-card">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="SENSORES INDIVIDUAIS (SÉRIES)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
              <CheckBox Grid.Column="1" Content="Selecionar todos exibidos"
                        IsThreeState="True"
                        IsChecked="{Binding SeriesCategorySelectionState, Mode=OneWay}"
                        Click="OnToggleSeriesCategoryClick"
                        FontSize="12"
                        VerticalAlignment="Center" />
            </Grid>

            <Grid ColumnDefinitions="200,*" ColumnSpacing="8">
              <ComboBox ItemsSource="{Binding SeriesCategories}"
                        SelectedItem="{Binding SelectedSeriesCategory, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" />
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox PlaceholderText="Série ou padrão (ex.: Gpu* ou DiskRead#1)" Text="{Binding SeriesPatternInput, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Classes="secondary" Content="Adicionar padrão" Click="OnAddSeriesPatternClick" />
              </Grid>
            </Grid>

            <Border Background="{DynamicResource BgWindowBrush}" BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,8">
              <StackPanel Spacing="4">
                <ItemsControl ItemsSource="{Binding SeriesChoices}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OverlayBlockContentChoiceViewModel}">
                      <CheckBox Classes="chip-toggle" Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Nenhuma série encontrada nesta categoria."
                           Classes="muted" FontSize="11"
                           IsVisible="{Binding NoSeriesChoices}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Card 3: Gráficos -->
        <Border Classes="desktop-card">
          <StackPanel Spacing="8">
            <TextBlock Text="GRÁFICOS DE SÉRIE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
            <ItemsControl ItemsSource="{Binding GraphChoices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:OverlayBlockContentChoiceViewModel}">
                  <Border Background="{DynamicResource BgWindowBrush}" BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,5" Margin="0,0,0,4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" FontSize="12" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="secondary" Content="Editar" Padding="10,4" Click="OnEditGraphClick" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="2*,*" ColumnSpacing="8">
              <TextBox PlaceholderText="Série (ex.: GpuTemperature#1)" Text="{Binding GraphSeries, UpdateSourceTrigger=PropertyChanged}" />
              <TextBox Grid.Column="1" PlaceholderText="Cor #RRGGBB (opcional)" Text="{Binding GraphColor, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
              <StackPanel Spacing="3"><TextBlock Text="ALTURA" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold" /><TextBox Text="{Binding GraphHeight, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
              <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="AMOSTRAS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold" /><TextBox Text="{Binding GraphWindow, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
              <StackPanel Grid.Column="2" Spacing="3"><TextBlock Text="MÍN." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold" /><TextBox PlaceholderText="Auto" Text="{Binding GraphMin, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
              <StackPanel Grid.Column="3" Spacing="3"><TextBlock Text="MÁX." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold" /><TextBox PlaceholderText="Auto" Text="{Binding GraphMax, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="secondary" Content="Novo gráfico" Click="OnNewGraphClick" />
              <Button Classes="action accent" Padding="12,6" Content="Salvar gráfico" Click="OnSaveGraphClick" />
              <Button Classes="secondary" Content="Remover selecionado" Click="OnRemoveGraphClick" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Card 4: Templates -->
        <Border Classes="desktop-card">
          <StackPanel Spacing="8">
            <TextBlock Text="TEMPLATES DE TEXTO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
            <ItemsControl ItemsSource="{Binding TemplateChoices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:OverlayBlockContentChoiceViewModel}">
                  <Border Background="{DynamicResource BgWindowBrush}" BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,5" Margin="0,0,0,4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" FontSize="12" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="secondary" Content="Editar" Padding="10,4" Click="OnEditTemplateClick" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="2*,*" ColumnSpacing="8">
              <TextBox PlaceholderText="Ex.: GPU {GpuTemperature:F0} °C" Text="{Binding TemplateText, UpdateSourceTrigger=PropertyChanged}" />
              <TextBox Grid.Column="1" PlaceholderText="Cor #RRGGBB (opcional)" Text="{Binding TemplateColor, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="secondary" Content="Novo template" Click="OnNewTemplateClick" />
              <Button Classes="action accent" Padding="12,6" Content="Salvar template" Click="OnSaveTemplateClick" />
              <Button Classes="secondary" Content="Remover selecionado" Click="OnRemoveTemplateClick" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="secondary" Content="Cancelar" Click="OnCancelClick" />
        <Button Classes="action accent" Content="Adicionar conteúdo" Click="OnAddClick" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
