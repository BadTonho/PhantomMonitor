<Window x:Class="PhantomMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phantom Monitor" Height="680" Width="920"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Width="210"
                Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Clean Brand Header -->
                <StackPanel Grid.Row="0" Margin="18,20,18,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="7" Height="7" CornerRadius="3.5" 
                                Background="{StaticResource AccentLightBrush}" 
                                Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="PHANTOM" FontSize="17" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="MONITOR" FontSize="10" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Card -->
                <Border Grid.Row="1" Background="{StaticResource BgSurfaceBrush}" 
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12,10" Margin="14,0,14,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" 
                                     Fill="{StaticResource TextMutedBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StatusText" Text="Parado" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="UptimeText" Text="Tempo: --" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="SensorCountText" Text="" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        <Border x:Name="UpdateBadge" CornerRadius="4" Padding="7,3" Margin="0,8,0,0"
                                Background="#1810B981" BorderBrush="#3510B981" BorderThickness="1"
                                Visibility="Collapsed" Cursor="Hand"
                                MouseLeftButtonUp="OnOpenReleasesPage">
                            <TextBlock x:Name="UpdateBadgeText" Text="Nova versão" FontSize="10"
                                       FontWeight="SemiBold" Foreground="#6EE7B7"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Navigation & Toggles -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,0">
                        <TextBlock Text="SENSORES" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="4,0,0,6"/>
                        <RadioButton Content="CPU" IsChecked="True"/>
                        <RadioButton Content="GPU"/>
                        <RadioButton Content="Memória RAM"/>
                        <RadioButton Content="Disco"/>
                        <RadioButton Content="Rede"/>

                        <TextBlock Text="CONFIGURAÇÕES" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="4,16,0,6"/>
                        <CheckBox x:Name="OverlayToggle" Content="Overlay no Jogo" IsChecked="False"
                                  Checked="OnOverlayToggled" Unchecked="OnOverlayToggled"/>
                        <Button Content="⚙ Configurar Overlay..." 
                                Style="{StaticResource SecondaryButton}"
                                Click="OnOpenOverlayEditor"
                                Padding="8,5" Margin="0,2,0,8" FontSize="11"
                                HorizontalAlignment="Stretch"/>
                        <Button Content="🔎 Inventário de Hardware"
                                Style="{StaticResource SecondaryButton}"
                                Click="OnOpenInventory"
                                Padding="8,5" Margin="0,0,0,8" FontSize="11"
                                HorizontalAlignment="Stretch"/>
                        <CheckBox x:Name="CsvToggle" Content="Exportar CSV"
                                  Checked="OnLoggingToggled" Unchecked="OnLoggingToggled"/>
                        <CheckBox x:Name="JsonToggle" Content="Exportar JSON"
                                  Checked="OnLoggingToggled" Unchecked="OnLoggingToggled"/>
                        <CheckBox x:Name="JournalToggle" Content="Journal JSON (jsonl)"
                                  ToolTip="Journal contínuo: uma linha por amostra + notas de sessão/reset (logs/sensors_*.jsonl). Rendimento constante — indicado para benchmarks e replay."
                                  Checked="OnLoggingToggled" Unchecked="OnLoggingToggled"/>
                        <CheckBox x:Name="StartupToggle" Content="Iniciar com o Windows"
                                  Checked="OnStartupToggled" Unchecked="OnStartupToggled"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Controls -->
                <StackPanel Grid.Row="3" Margin="14,10,14,16">
                    <Button x:Name="StartButton" Content="Iniciar Monitor"
                            Style="{StaticResource PrimaryButton}"
                            Click="OnStartClick" Margin="0,0,0,6"/>
                    <Button x:Name="StopButton" Content="Parar"
                            Style="{StaticResource SecondaryButton}"
                            Click="OnStopClick" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="24,20"
                      Background="{StaticResource BgDarkBrush}">
            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <TextBlock Text="Visão Geral do Sistema" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="LastUpdateText" Text="Aguardando..."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Admin Warning Banner -->
                <Border x:Name="AdminWarning" Background="#18EF4444" BorderBrush="#35EF4444"
                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Privilégios Administrativos Necessários" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#FCA5A5"/>
                            <TextBlock Text="Leituras completas de temperatura de CPU e FPS via PresentMon necessitam de elevação."
                                       FontSize="11" Foreground="#F87171" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Executar como Admin"
                                Background="#DC2626" Foreground="White" BorderThickness="0"
                                FontSize="11" FontWeight="SemiBold" Padding="12,6"
                                Cursor="Hand" Click="OnRestartAsAdmin"
                                VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- Update Banner -->
                <Border x:Name="UpdateBanner" Background="#1810B981" BorderBrush="#3510B981"
                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Nova versão disponível" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#6EE7B7"/>
                            <TextBlock x:Name="UpdateBannerText" Text="" FontSize="11"
                                       Foreground="#A7F3D0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Ver no GitHub"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="11" FontWeight="SemiBold" Padding="12,6"
                                    Cursor="Hand" Click="OnOpenReleasesPage"/>
                            <Button x:Name="UpdateBannerApplyButton" Content="Atualizar e reiniciar"
                                    Background="#059669" Foreground="White" BorderThickness="0"
                                    FontSize="11" FontWeight="SemiBold" Padding="12,6" Margin="8,0,0,0"
                                    Cursor="Hand" Click="OnUpdateAndRestartClick" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CPU Card -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="PROCESSADOR (CPU)" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Border x:Name="CpuTempRing" CornerRadius="12" Padding="8,3"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="{StaticResource BgSurfaceBrush}" 
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="TEMP " FontSize="9" FontWeight="Bold" 
                                               Foreground="{StaticResource TextMutedBrush}" 
                                               VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <TextBlock x:Name="CpuTempRingText" Text="--°C" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Card Body -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="CpuUsageText" Text="0.0%"
                                           FontSize="28" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="CpuTempText" Text="--°C" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" Visibility="Collapsed"/>
                            </StackPanel>

                            <ProgressBar x:Name="CpuProgressBar" Grid.Column="1" Height="5" 
                                         VerticalAlignment="Center" Margin="16,0,16,0"
                                         Minimum="0" Maximum="100"
                                         Style="{StaticResource CleanProgressBarStyle}"/>

                            <Border Grid.Column="2" CornerRadius="5" Background="{StaticResource BgSurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Padding="10,4" VerticalAlignment="Center">
                                <TextBlock x:Name="CpuRingText" Text="0%" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>

                        <!-- Detalhes: clock / potência / voltagem -->
                        <TextBlock x:Name="CpuDetailText" Grid.Row="2" Text=""
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- GPU Card -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="PLACA DE VÍDEO (GPU)" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Border x:Name="GpuTempRing" CornerRadius="12" Padding="8,3"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="{StaticResource BgSurfaceBrush}" 
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="TEMP " FontSize="9" FontWeight="Bold" 
                                               Foreground="{StaticResource TextMutedBrush}" 
                                               VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <TextBlock x:Name="GpuTempRingText" Text="--°C" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Card Body -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="GpuUsageText" Text="0.0%"
                                           FontSize="28" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="GpuTempText" Text="--°C" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" Visibility="Collapsed"/>
                            </StackPanel>

                            <ProgressBar x:Name="GpuProgressBar" Grid.Column="1" Height="5" 
                                         VerticalAlignment="Center" Margin="16,0,16,0"
                                         Minimum="0" Maximum="100"
                                         Style="{StaticResource CleanProgressBarStyle}"/>

                            <Border Grid.Column="2" CornerRadius="5" Background="{StaticResource BgSurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Padding="10,4" VerticalAlignment="Center">
                                <TextBlock x:Name="GpuRingText" Text="0%" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>

                        <!-- Detalhes: VRAM / clock / potência / hotspot -->
                        <TextBlock x:Name="GpuDetailText" Grid.Row="2" Text=""
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- FPS Card -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="TAXA DE QUADROS (FPS)" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Border CornerRadius="12" Padding="8,3"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="{StaticResource BgSurfaceBrush}" 
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="FRAMETIME " FontSize="9" FontWeight="Bold" 
                                               Foreground="{StaticResource TextMutedBrush}" 
                                               VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <TextBlock x:Name="FrametimeText" Text="-- ms" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentLightBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Card Body -->
                        <StackPanel Grid.Row="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock x:Name="FpsText" Text="--"
                                           FontSize="30" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="FPS" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" 
                                           Margin="6,0,0,5" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock x:Name="FpsDetailsText" Text="Mín: -- | Avg: -- | 1% Low: -- | 0.1% Low: -- | Máx: --"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- RAM & Disk Grid -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- RAM Card -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="MEMÓRIA RAM" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <Border CornerRadius="5" Background="{StaticResource BgSurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="RamRingText" Text="0%" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="RamUsageText" Text="0.0%"
                                       FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <ProgressBar x:Name="RamProgressBar" Height="5" 
                                         Margin="0,8,0,8" Minimum="0" Maximum="100"
                                         Style="{StaticResource CleanProgressBarStyle}"/>
                            <TextBlock x:Name="RamAvailableText" Text="-- GB disponível"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="RamTotalText" Text="" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Disk Card -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="ARMAZENAMENTO (DISCO)" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="DiskUsageText" Text="0.0%"
                                       FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <ProgressBar x:Name="DiskProgressBar" Height="5" 
                                         Margin="0,8,0,8" Minimum="0" Maximum="100"
                                         Style="{StaticResource CleanProgressBarStyle}"/>
                            <TextBlock x:Name="DiskIoText" Text="--"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Network & Motherboard/Fans Grid -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Network Card -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="REDE" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="NetworkDownText" Text="↓ --"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="NetworkUpText" Text="↑ --"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Motherboard & Fans Card -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="PLACA-MÃE &amp; VENTOINHAS" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="MotherboardTempText" Text="--°C"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="FanSpeedsText" Text="Ventoinhas: --"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- GPU Processes Card -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="PROCESSOS ATIVOS NA GPU" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="GpuProcessList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"/>
                                            <TextBlock Text="{Binding Usage, StringFormat={}{0:F1}%}"
                                                       Grid.Column="1"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Update Card -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="ATUALIZAÇÕES" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Button Content="Buscar agora" Style="{StaticResource SecondaryButton}"
                                    FontSize="11" Padding="10,4"
                                    HorizontalAlignment="Right" Click="OnCheckUpdatesClick"/>
                        </Grid>
                        <TextBlock x:Name="UpdateVersionText" Text="" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="UpdateStatusText" Text="" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                        <CheckBox x:Name="AutoCheckToggle" Content="Verificar automaticamente (no arranque e a cada 24h)"
                                  FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,10,0,0"
                                  Checked="OnUpdateAutoCheckToggled" Unchecked="OnUpdateAutoCheckToggled"/>
                        <CheckBox x:Name="BetaChannelToggle" Content="Canal beta (aceitar pré-releases do GitHub)"
                                  FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,6,0,0"
                                  Checked="OnUpdateBetaToggled" Unchecked="OnUpdateBetaToggled"/>
                        <Button x:Name="UpdateApplyButton" Content="Atualizar e reiniciar"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="11" Padding="10,5" Margin="0,10,0,0"
                                Click="OnUpdateAndRestartClick" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Footer Action -->
                <Button Content="Diagnóstico: sensores e erros do aplicativo"
                        Style="{StaticResource SecondaryButton}"
                        Click="OnOpenDebugWindow"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
