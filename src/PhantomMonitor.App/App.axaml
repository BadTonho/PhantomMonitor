<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhantomMonitor.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Tema builtin: "neptune" no merge do XAML; App.ApplyConfiguredTheme()
             troca no boot (config.json "theme" (neptune|slate) e a CLI com dois
             hífens, theme=<nome>, sobrepõe; a grafia legada ui-theme= segue
             aceita). Desde a Fase 3 o mesmo dicionário é trocado em runtime pelo
             seletor na página Configurações (App.ApplyTheme). Os dois dicionários
             têm a MESMA lista de chaves; as views usam DynamicResource. -->
        <ResourceInclude Source="avares://PhantomMonitor/Themes/Tokens.Neptune.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
