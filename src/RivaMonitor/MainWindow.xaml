<Window x:Class="RivaMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Riva Monitor" Height="680" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Width="220"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="16,16,16,12">
                    <TextBlock Text="RIVA" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="MONITOR" FontSize="10" FontWeight="Light"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Status -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="16,0,16,12">
                    <StackPanel>
                        <TextBlock Text="STATUS" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="StatusText" Text="Parado" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="UptimeText" Text="--" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <StackPanel Grid.Row="2" Margin="16,0">
                    <TextBlock Text="SENSORES" FontSize="9" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,8"/>
                    <RadioButton Content="CPU" IsChecked="True" Margin="0,4" FontSize="13"
                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                    <RadioButton Content="GPU" Margin="0,4" FontSize="13"
                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                    <RadioButton Content="Memória" Margin="0,4" FontSize="13"
                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                    <RadioButton Content="Disco" Margin="0,4" FontSize="13"
                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                    <RadioButton Content="Rede" Margin="0,4" FontSize="13"
                                 Foreground="{StaticResource TextSecondaryBrush}"/>

                    <TextBlock Text="EXIBIÇÃO" FontSize="9" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,16,0,8"/>
                    <CheckBox x:Name="OverlayToggle" Content="Overlay" IsChecked="True"
                              Margin="0,4" FontSize="13"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              Checked="OnOverlayToggled" Unchecked="OnOverlayToggled"/>
                    <CheckBox x:Name="CsvToggle" Content="Salvar CSV" Margin="0,4"
                              FontSize="13"
                              Foreground="{StaticResource TextSecondaryBrush}"/>
                    <CheckBox x:Name="JsonToggle" Content="Salvar JSON" Margin="0,4"
                              FontSize="13"
                              Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Controls -->
                <StackPanel Grid.Row="3" Margin="16,0,16,16">
                    <Button x:Name="StartButton" Content="INICIAR"
                            Style="{StaticResource PrimaryButton}"
                            Click="OnStartClick" Margin="0,0,0,8"/>
                    <Button x:Name="StopButton" Content="PARAR"
                            Style="{StaticResource SecondaryButton}"
                            Click="OnStopClick" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="24">
            <StackPanel>
                <TextBlock Text="VISÃO GERAL" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,8,0,16"/>

                <!-- CPU Card -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CPU" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CpuUsageText" Text="0.0%"
                                       FontSize="36" FontWeight="Light"
                                       Foreground="{StaticResource GreenBrush}"
                                       Margin="0,8,0,4"/>
                            <TextBlock x:Name="CpuTempText" Text="--°C"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="80" Height="80" CornerRadius="40"
                                Background="#0A1E90FF" BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2">
                            <TextBlock x:Name="CpuRingText" Text="0%"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- GPU Card -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="GPU" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="GpuUsageText" Text="0.0%"
                                       FontSize="36" FontWeight="Light"
                                       Foreground="{StaticResource GreenBrush}"
                                       Margin="0,8,0,4"/>
                            <TextBlock x:Name="GpuTempText" Text="--°C"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="80" Height="80" CornerRadius="40"
                                Background="#0A1E90FF" BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2">
                            <TextBlock x:Name="GpuRingText" Text="0%"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Grid: RAM + Disco -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="MEMÓRIA RAM" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="RamUsageText" Text="0.0%"
                                       FontSize="28" FontWeight="Light"
                                       Foreground="{StaticResource GreenBrush}"
                                       Margin="0,6,0,2"/>
                            <TextBlock x:Name="RamAvailableText" Text="-- GB disponível"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="DISCO" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DiskUsageText" Text="0.0%"
                                       FontSize="28" FontWeight="Light"
                                       Foreground="{StaticResource GreenBrush}"
                                       Margin="0,6,0,2"/>
                            <TextBlock x:Name="DiskIoText" Text="--"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- GPU Processes -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="PROCESSOS GPU" FontSize="11" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <ItemsControl x:Name="GpuProcessList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding Usage, StringFormat={}{0:F1}%}"
                                                   Grid.Column="1"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="LastUpdateText" Text="Aguardando..."
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Right" Margin="0,0,0,16"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
