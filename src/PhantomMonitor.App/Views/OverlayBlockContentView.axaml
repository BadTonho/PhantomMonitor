<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="using:PhantomMonitor.App.Controls"
             xmlns:vm="using:PhantomMonitor.App.ViewModels"
             x:Class="PhantomMonitor.App.Views.OverlayBlockContentView"
             xmlns:vmroot="using:PhantomMonitor.App.ViewModels"
             x:DataType="vmroot:OverlayCanvasBlockViewModel"
             Width="{Binding PresentationWidth}">
  <Border Margin="{Binding PresentationOuterMargin}"
          CornerRadius="6"
          Background="{Binding PresentationBackgroundBrush}"
          BorderBrush="{Binding PresentationBorderBrush}"
          BorderThickness="{Binding PresentationBorderThickness}"
          Padding="{Binding PresentationPadding}"
          PointerPressed="OnDragHandlePointerPressed">
    <StackPanel Spacing="{Binding PresentationContentSpacing}">
      <TextBlock Text="{Binding Title}" IsVisible="{Binding ShowTitle}" Foreground="{DynamicResource TextOverlaySecondaryBrush}"
                 FontFamily="{Binding PresentationNameFontFamily}"
                 FontSize="{Binding PresentationNameFontSize}" FontWeight="SemiBold"
                 PointerPressed="OnDragHandlePointerPressed" Cursor="SizeAll" />
      <ItemsControl ItemsSource="{Binding Content}">
        <ItemsControl.DataTemplates>
          <DataTemplate DataType="vm:OverlayBlockMetricViewModel">
            <StackPanel Spacing="2" Margin="{Binding $parent[UserControl].((vm:OverlayCanvasBlockViewModel)DataContext).PresentationRowMargin}">
              <TextBlock Text="{Binding Name}" IsVisible="{Binding ShowName}" Foreground="{Binding NameForeground}"
                         FontFamily="{Binding $parent[UserControl].((vm:OverlayCanvasBlockViewModel)DataContext).PresentationNameFontFamily}"
                         FontSize="{Binding $parent[UserControl].((vm:OverlayCanvasBlockViewModel)DataContext).PresentationNameFontSize}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Value}" Foreground="{Binding ValueForeground}"
                         FontSize="{Binding $parent[UserControl].((vm:OverlayCanvasBlockViewModel)DataContext).PresentationValueFontSize}"
                         FontFamily="{Binding $parent[UserControl].((vm:OverlayCanvasBlockViewModel)DataContext).PresentationValueFontFamily}" TextWrapping="WrapWithOverflow" />
              <charts:HistoryChart IsVisible="{Binding ShowFrametimeGraph}"
                                   Values="{Binding $parent[UserControl].((vm:OverlayCanvasBlockViewModel)DataContext).Owner.FrametimeSamples}"
                                   Stroke="{Binding $parent[UserControl].((vm:OverlayCanvasBlockViewModel)DataContext).PresentationAccentBrush}"
                                   GuideBrush="{DynamicResource OverlayGuideBrush}"
                                   MinY="0" MaxFloor="33.3" GuideAt="16.66"
                                   Height="{Binding $parent[UserControl].((vm:OverlayCanvasBlockViewModel)DataContext).PresentationFrametimeGraphHeight}" />
            </StackPanel>
          </DataTemplate>
          <DataTemplate DataType="vm:OverlayGraphRowViewModel">
            <charts:HistoryChart Values="{Binding Samples}" Stroke="{Binding Stroke}"
                                 MinY="{Binding MinY}" MaxY="{Binding MaxY}" Height="{Binding Height}" />
          </DataTemplate>
          <DataTemplate DataType="vm:OverlayFrametimeGraphViewModel">
            <charts:HistoryChart Values="{Binding Owner.FrametimeSamples}"
                                 Stroke="{Binding Owner.OverlayAccentBrush}"
                                 GuideBrush="{DynamicResource OverlayGuideBrush}"
                                 MinY="0" MaxFloor="33.3" GuideAt="16.66"
                                 Height="{Binding Block.PresentationFrametimeGraphHeight}" />
          </DataTemplate>
          <DataTemplate DataType="vm:OverlayTemplateRowViewModel">
            <TextBlock Text="{Binding Text}" Foreground="{Binding TextBrush}" IsVisible="{Binding IsVisible}"
                       FontSize="{Binding $parent[UserControl].((vm:OverlayCanvasBlockViewModel)DataContext).PresentationValueFontSize}"
                       FontFamily="{Binding $parent[UserControl].((vm:OverlayCanvasBlockViewModel)DataContext).PresentationValueFontFamily}" TextTrimming="CharacterEllipsis"
                       Margin="{Binding $parent[UserControl].((vm:OverlayCanvasBlockViewModel)DataContext).PresentationRowMargin}" />
          </DataTemplate>
          <DataTemplate DataType="vm:OverlayCustomLineViewModel">
            <TextBlock Text="{Binding Text}" IsVisible="{Binding IsVisible}" FontSize="{Binding FontSize}"
                       Width="{Binding Width}" HorizontalAlignment="Left" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontFamily="{Binding $parent[UserControl].((vm:OverlayCanvasBlockViewModel)DataContext).PresentationValueFontFamily}"
                       Margin="{Binding $parent[UserControl].((vm:OverlayCanvasBlockViewModel)DataContext).PresentationRowMargin}" />
          </DataTemplate>
        </ItemsControl.DataTemplates>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
