<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:charts="using:PhantomMonitor.App.Controls"
        xmlns:pages="using:PhantomMonitor.App.Views"
        x:Class="PhantomMonitor.App.Views.MainWindow"
             xmlns:vmroot="using:PhantomMonitor.App.ViewModels"
             xmlns:models="using:PhantomMonitor.Models"
             x:DataType="vmroot:MainWindowViewModel"
        Title="Phantom Monitor"
        Icon="avares://PhantomMonitor/Assets/fantasma.ico"
        Width="1120" Height="790" MinWidth="850" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgWindowBrush}">
  <Window.Styles>
    <StyleInclude Source="avares://PhantomMonitor/Themes/DesktopStyles.axaml" />

    <Style Selector="TextBlock.metric">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.diagnostic-tab">
      <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BgCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Foreground" Value="{DynamicResource NavForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.diagnostic-tab:pointerover">
      <Setter Property="Background" Value="{DynamicResource NavSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NavForegroundSelectedBrush}" />
    </Style>
    <Style Selector="Button.diagnostic-tab.selected">
      <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NavForegroundSelectedBrush}" />
    </Style>
    <!-- Navegação da sidebar (porta do RadioButton do Styles.xaml do WPF): indicador
         3×14 com AccentLightBrush no selecionado, fundo/texto por tokens Nav*.
         Hover = NavSoftBrush, selecionado = NavSelectedBrush + SemiBold. -->
    <Style Selector="Button.nav">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource NavForegroundBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
              <Border x:Name="Indicator" Width="3" Height="14" CornerRadius="1.5" Margin="-2,0,7,0"
                      Background="{DynamicResource AccentLightBrush}" />
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.nav /template/ Border#Indicator">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.nav:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="{DynamicResource NavSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NavForegroundSelectedBrush}" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ Border#Indicator">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- Depois do :pointerover para o hover não sobrescrever o item selecionado. -->
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NavForegroundSelectedBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav.selected /template/ Border#Indicator">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.dock-status">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="MinWidth" Value="42" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="21" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.dock-status:pointerover">
      <Setter Property="Background" Value="{DynamicResource NavSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <!-- Badge de update (porta do chip verde do WPF na sidebar) -->
    <Style Selector="Button.update-badge">
      <Setter Property="Background" Value="{DynamicResource BgToastUpdateBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderTintGreenBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBox.settings-input">
      <Setter Property="Width" Value="190" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="ToggleButton.inventory-group">
      <Setter Property="Background" Value="{DynamicResource BgChipBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BgCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="*,Auto">
              <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
              <TextBlock x:Name="Arrow" Grid.Column="1" Foreground="{TemplateBinding Foreground}"
                         FontSize="15" VerticalAlignment="Center" Margin="12,0,2,0" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.inventory-group /template/ TextBlock#Arrow">
      <Setter Property="Text" Value="⌄" />
    </Style>
    <Style Selector="ToggleButton.inventory-group:checked /template/ TextBlock#Arrow">
      <Setter Property="Text" Value="⌃" />
    </Style>
    <Style Selector="ToggleButton.inventory-group:pointerover">
      <Setter Property="Background" Value="{DynamicResource NavSoftBrush}" />
    </Style>
    <Style Selector="ToggleButton.inventory-group:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
    </Style>
    <Style Selector="Button.inventory-row-toggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.inventory-row-toggle:pointerover">
      <Setter Property="Background" Value="{DynamicResource NavSoftBrush}" />
    </Style>
    <Style Selector="Button.inventory-row-toggle:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
    </Style>
  </Window.Styles>

  <Grid x:Name="MainLayout" ColumnDefinitions="230,*" RowDefinitions="Auto,*,Auto">
    <Border x:Name="Sidebar" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BgSidebarBorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="16,22">
        <StackPanel Spacing="3" IsVisible="{Binding IsLeftNavigation}">
          <TextBlock Text="PHANTOM" IsVisible="{Binding ShowNavigationLabels}" Foreground="{DynamicResource TextBrightBrush}" FontSize="19" FontWeight="Bold" />
          <TextBlock Text="P" IsVisible="{Binding !ShowNavigationLabels}" Foreground="{DynamicResource TextBrightBrush}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" />
          <TextBlock Text="HARDWARE MONITOR" IsVisible="{Binding ShowNavigationLabels}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
        </StackPanel>

        <ScrollViewer x:Name="SidebarNavigationScrollViewer" Grid.Row="1" Margin="0,28,0,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="NavigationItemsPanel" Spacing="6">
          <TextBlock x:Name="SidebarNavigationHeading" Text="MONITORAMENTO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="8,0,0,4" />
          <Button x:Name="NavOverview" Classes="nav" Click="OnOverviewClick" ToolTip.Tip="Visão geral" AutomationProperties.Name="Visão geral">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Data="M 2,8 L 8,2 L 14,8 L 14,14 L 2,14 Z M 6,14 L 6,9 L 10,9 L 10,14" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
              <TextBlock Text="Visão geral" IsVisible="{Binding ShowNavigationLabels}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavInventory" Classes="nav" Click="OnInventoryClick" ToolTip.Tip="Inventário" AutomationProperties.Name="Inventário">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Data="M 2,2 L 14,2 L 14,14 L 2,14 Z M 2,6 L 14,6 M 6,6 L 6,14" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
              <TextBlock Text="Inventário" IsVisible="{Binding ShowNavigationLabels}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavCustomSensors" Classes="nav" Click="OnCustomSensorsClick" ToolTip.Tip="Sensores customizados"
                  IsVisible="{Binding ShowCustomSensorsInSidebar}" AutomationProperties.Name="Sensores customizados">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Data="M 2,12 L 5,8 L 8,10 L 12,3 L 14,4" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
              <TextBlock Text="Sensores customizados" IsVisible="{Binding ShowNavigationLabels}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavSensorTuning" Classes="nav" Click="OnSensorTuningClick" ToolTip.Tip="Ajuste por série"
                  IsVisible="{Binding ShowSensorTuningInSidebar}" AutomationProperties.Name="Ajuste por série">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Data="M 2,4 L 14,4 M 2,8 L 14,8 M 2,12 L 14,12 M 5,2 L 5,6 M 11,6 L 11,10 M 7,10 L 7,14" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
              <TextBlock Text="Ajuste por série" IsVisible="{Binding ShowNavigationLabels}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavAlerts" Classes="nav" Click="OnAlertsClick" ToolTip.Tip="Alertas"
                  IsVisible="{Binding ShowAlertsInSidebar}" AutomationProperties.Name="Alertas">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Data="M 8,2 L 14,13 L 2,13 Z M 8,6 L 8,9 M 8,11 L 8,11.5" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
              <TextBlock Text="Alertas" IsVisible="{Binding ShowNavigationLabels}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavDiagnostics" Classes="nav" Click="OnDiagnosticsClick" ToolTip.Tip="Diagnóstico" AutomationProperties.Name="Diagnóstico">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Data="M 8,2 A 6,6 0 1 1 7.99,2 M 8,7 L 8,11 M 8,4.5 L 8,5" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
              <TextBlock Text="Diagnóstico" IsVisible="{Binding ShowNavigationLabels}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavSettings" Classes="nav" Click="OnSettingsClick" ToolTip.Tip="Configurações" AutomationProperties.Name="Configurações">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Data="M 2,4 L 14,4 M 2,8 L 14,8 M 2,12 L 14,12 M 5,2 L 5,6 M 10,6 L 10,10 M 6,10 L 6,14" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
              <TextBlock Text="Configurações" IsVisible="{Binding ShowNavigationLabels}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        </ScrollViewer>

        <Border x:Name="SidebarStatusPanel" Grid.Row="2" Background="{DynamicResource BgCardBrush}" CornerRadius="9" Padding="11" IsVisible="{Binding IsLeftNavigation}">
          <StackPanel Spacing="5">
            <TextBlock Text="ESTADO" IsVisible="{Binding ShowNavigationLabels}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusText}" IsVisible="{Binding ShowNavigationLabels}" Foreground="{DynamicResource TextStatusBrush}" FontSize="12" />
            <Ellipse Width="12" Height="12" IsVisible="{Binding !ShowNavigationLabels}" Fill="{DynamicResource TextStatusBrush}" HorizontalAlignment="Center" />
            <Button Classes="update-badge" IsVisible="{Binding UpdateBadgeVisible}" Click="OnUpdateBadgeClick" ToolTip.Tip="{Binding UpdateBadgeText}">
              <Grid>
                <TextBlock Text="{Binding UpdateBadgeText}" IsVisible="{Binding ShowNavigationLabels}" Foreground="{DynamicResource AccentGreenSoftBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Left" />
                <Border Width="18" Height="18" CornerRadius="9" IsVisible="{Binding !ShowNavigationLabels}"
                        Background="{DynamicResource AccentWarningBrush}" HorizontalAlignment="Center">
                  <TextBlock Text="!" Foreground="{DynamicResource BgWindowBrush}" FontSize="11" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                </Border>
              </Grid>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <Border x:Name="BottomNavigationBar" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
            IsVisible="{Binding IsBottomNavigation}" Background="{DynamicResource BgSidebarBrush}"
            BorderBrush="{DynamicResource BgSidebarBorderBrush}" BorderThickness="0,1,0,0" Padding="10,7">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <ScrollViewer x:Name="BottomNavigationScrollViewer" Grid.Column="0" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Auto" HorizontalContentAlignment="Left" VerticalAlignment="Center">
          <!-- NavigationItemsPanel is moved here at runtime so both layouts share the same buttons and selection state. -->
        </ScrollViewer>
        <Border Grid.Column="1" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="9,5" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="ESTADO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold" />
              <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextStatusBrush}" FontSize="11" />
            </StackPanel>
            <Button Classes="update-badge" IsVisible="{Binding UpdateBadgeVisible}" Click="OnUpdateBadgeClick" Padding="7,4">
              <TextBlock Text="{Binding UpdateBadgeText}" Foreground="{DynamicResource AccentGreenSoftBrush}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Left" />
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border x:Name="DockNavigationBar" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" ZIndex="15"
            IsVisible="{Binding IsDockNavigation}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="18,0,18,18" Padding="8,6" MaxWidth="780" Background="{DynamicResource BgSidebarBrush}"
            BorderBrush="{DynamicResource BgCardBorderBrush}" BorderThickness="1" CornerRadius="24">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <ScrollViewer x:Name="DockNavigationScrollViewer" Grid.Column="0" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Auto" HorizontalContentAlignment="Left" VerticalAlignment="Center" MaxWidth="700">
          <!-- NavigationItemsPanel é movido para cá no modo dock; os mesmos botões mantêm seleção e preferências BETA. -->
        </ScrollViewer>
        <Button Grid.Column="1" Classes="dock-status" Click="OnDockStatusClick"
                ToolTip.Tip="{Binding DockStatusTooltip}"
                AutomationProperties.Name="Estado do monitoramento e atualizações">
          <Grid Width="22" Height="22">
            <Ellipse Width="12" Height="12" Fill="{DynamicResource TextStatusBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Width="11" Height="11" CornerRadius="6" Background="{DynamicResource AccentWarningBrush}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding UpdateBadgeVisible}">
              <TextBlock Text="!" Foreground="{DynamicResource BgWindowBrush}" FontSize="8" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
            </Border>
          </Grid>
        </Button>
      </Grid>
    </Border>

    <pages:OverviewPage Grid.Column="1" Grid.Row="1" />

    <pages:InventoryPage OpenHardwareInventoryRequested="OnOpenHardwareInventoryRequested" Grid.Column="1" Grid.Row="1" />

    <pages:SettingsPage OpenOverlayEditorRequested="OnOpenOverlayEditorRequested"
                        OpenThemePaletteEditorRequested="OnOpenThemePaletteEditorRequested" Grid.Column="1" Grid.Row="1" />

    <pages:CustomSensorsPage Grid.Column="1" Grid.Row="1" />

    <pages:SensorTuningPage Grid.Column="1" Grid.Row="1" />

    <pages:AlertsPage Grid.Column="1" Grid.Row="1" />

    <pages:DiagnosticsPage x:Name="DiagnosticsPageControl" Grid.Column="1" Grid.Row="1" />

    <!-- Toast de alerta (paridade estrutural do AlertPopupWindow do WPF; cores via tokens AlertToast*). -->
    <Border Grid.Column="1" Grid.Row="1" ZIndex="10" IsVisible="{Binding AlertToastVisible}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,18,0" MaxWidth="420" Background="{DynamicResource AlertToastBackgroundBrush}" BorderBrush="{DynamicResource AlertToastBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
      <StackPanel Spacing="5">
        <TextBlock Text="PHANTOM MONITOR · ALERTA" Foreground="{DynamicResource AlertToastHeaderBrush}" FontSize="11" FontWeight="Bold" />
        <TextBlock Text="{Binding AlertToastMessage}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Update update: same pattern as the alerts toast, in the top-right corner of the dashboard. -->
    <Border Grid.Column="1" Grid.Row="1" ZIndex="10" IsVisible="{Binding UpdateToastVisible}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,18,0" MaxWidth="440" Background="{DynamicResource BgToastUpdateBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
      <StackPanel Spacing="8">
        <TextBlock Text="PHANTOM MONITOR · ATUALIZAÇÃO" Foreground="{DynamicResource AccentGreenSoftBrush}" FontSize="11" FontWeight="Bold" />
        <TextBlock Text="{Binding UpdateToastText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Abrir GitHub" Click="OnOpenReleasesPageClick" />
          <Button Content="{Binding UpdateButtonText}" Click="OnApplyUpdateClick"
                  IsVisible="{Binding CanApplyUpdate}" IsEnabled="{Binding CanApplyUpdateEnabled}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Column="1" Grid.Row="1" ZIndex="20" IsVisible="{Binding SettingsSavePanelVisible}"
            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,18,18" MaxWidth="500"
            Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BgCardBorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="12">
      <StackPanel Spacing="7">
        <Button Classes="action settings-save" Content="Salvar e aplicar" Click="OnSaveSettingsClick"
                IsVisible="{Binding SettingsSaveButtonVisible}" IsEnabled="{Binding !IsSavingSettings}"
                HorizontalAlignment="Left"
                Background="{Binding SettingsSaveButtonBrush}"
                Foreground="{DynamicResource BgWindowBrush}"
                BorderBrush="{Binding SettingsSaveButtonBrush}"
                BorderThickness="1" />
        <TextBlock Text="{Binding SettingsSaveMessage}" IsVisible="{Binding HasSettingsSaveMessage}"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" MaxWidth="460" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
