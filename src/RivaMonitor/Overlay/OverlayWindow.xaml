<Window x:Class="RivaMonitor.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RivaMonitor Overlay" Height="400" Width="220"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SizeToContent="Height"
        IsHitTestVisible="False">
    <Border x:Name="MainBorder" CornerRadius="12" Background="#DE080A0F"
            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" Padding="12,10"
            Effect="{StaticResource CardShadow}">
        <StackPanel x:Name="SensorPanel">
            <!-- built programmatically -->
        </StackPanel>
    </Border>
</Window>
